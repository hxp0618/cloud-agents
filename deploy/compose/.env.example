# Copy to a deployment-owned env file and replace every value.
CLOUD_AGENTS_RELEASE_DIR=/absolute/path/to/platform-release
CLOUD_AGENTS_DEPLOY_DIR=/absolute/path/to/extracted/deploy
CLOUD_AGENTS_PLATFORM=linux/amd64

CLOUD_AGENTS_POSTGRES_DB=cloud_agents
CLOUD_AGENTS_POSTGRES_INSTALL_PASSWORD=replace-with-a-secret
CLOUD_AGENTS_MIGRATION_PASSWORD=replace-with-a-secret
CLOUD_AGENTS_RUNTIME_PASSWORD=replace-with-a-secret
CLOUD_AGENTS_TENANT_BOOTSTRAP_PASSWORD=replace-with-a-secret
CLOUD_AGENTS_IDENTITY_BOOTSTRAP_PASSWORD=replace-with-a-secret
CLOUD_AGENTS_IDENTITY_SERVICE_PASSWORD=replace-with-a-secret
CLOUD_AGENTS_BOOTSTRAP_DATABASE_URL=postgresql://cloud_agents_install_admin:replace-with-a-secret@postgres:5432/cloud_agents
CLOUD_AGENTS_MIGRATION_DATABASE_URL=postgresql://cloud_agents_migration:replace-with-a-secret@postgres:5432/cloud_agents
CLOUD_AGENTS_RUNTIME_DATABASE_URL=postgresql://cloud_agents_runtime_login:replace-with-a-secret@postgres:5432/cloud_agents
CLOUD_AGENTS_TENANT_BOOTSTRAP_DATABASE_URL=postgresql://cloud_agents_tenant_bootstrap:replace-with-a-secret@postgres:5432/cloud_agents

# Copy the three packaged JSON examples and keep their issuer/audiences identical.
CLOUD_AGENTS_IDENTITY_RUN_CONFIG=/absolute/path/to/identity-run.json
CLOUD_AGENTS_IDENTITY_INITIALIZE_CONFIG=/absolute/path/to/identity-initialize.json
CLOUD_AGENTS_CONTROL_PLANE_IDENTITY_CONFIG=/absolute/path/to/control-plane-identity.json
CLOUD_AGENTS_IDENTITY_ISSUER=https://identity.cloud-agents.example
CLOUD_AGENTS_IDENTITY_INITIALIZE=1
CLOUD_AGENTS_INITIAL_SUPER_ADMIN_USER_ID=initial-admin
CLOUD_AGENTS_IDENTITY_DATABASE_URL_FILE=/absolute/path/to/identity-service-database-url
CLOUD_AGENTS_IDENTITY_BOOTSTRAP_DATABASE_URL_FILE=/absolute/path/to/identity-bootstrap-database-url
CLOUD_AGENTS_IDENTITY_TLS_DIR=/absolute/path/to/identity-tls
CLOUD_AGENTS_IDENTITY_CA_FILE=/absolute/path/to/identity-ca.crt
CLOUD_AGENTS_IDENTITY_SIGNING_KEY_FILE=/absolute/path/to/identity-signing.key
CLOUD_AGENTS_IDENTITY_CSRF_KEY_FILE=/absolute/path/to/identity-csrf.key
CLOUD_AGENTS_IDENTITY_PROVIDER_FLOW_KEY_FILE=/absolute/path/to/identity-provider-flow.key
CLOUD_AGENTS_IDENTITY_PROVIDER_MATERIALS_DIR=/absolute/path/to/identity-provider-materials
CLOUD_AGENTS_IDENTITY_SETUP_PROOF_FILE=/absolute/path/to/identity-setup.proof
CLOUD_AGENTS_IDENTITY_INITIAL_PASSWORD_HASH_FILE=/absolute/path/to/initial-admin-password.hash
CLOUD_AGENTS_ADMIN_WEB_IDENTITY_PROOF_FILE=/absolute/path/to/admin-web-identity.proof
CLOUD_AGENTS_USER_WEB_IDENTITY_PROOF_FILE=/absolute/path/to/user-web-identity.proof
CLOUD_AGENTS_CONTROL_PLANE_IDENTITY_PROOF_FILE=/absolute/path/to/control-plane-identity.proof
CLOUD_AGENTS_IDENTITY_CONTROL_PLANE_PROOF_FILE=/absolute/path/to/identity-control-plane.proof

CLOUD_AGENTS_TENANT_UID=tenant-example
CLOUD_AGENTS_TENANT_NAME=tenant-example
CLOUD_AGENTS_TENANT_DISPLAY_NAME=Example Tenant
CLOUD_AGENTS_ORGANIZATION_UID=organization-example
CLOUD_AGENTS_ORGANIZATION_NAME=organization-example
CLOUD_AGENTS_ORGANIZATION_DISPLAY_NAME=Example Organization
CLOUD_AGENTS_ADMIN_MEMBERSHIP_UID=membership-initial-admin
CLOUD_AGENTS_ADMIN_MEMBERSHIP_NAME=membership-initial-admin
CLOUD_AGENTS_ADMIN_ROLE_BINDING_UID=role-binding-initial-admin
CLOUD_AGENTS_ADMIN_ROLE_BINDING_NAME=role-binding-initial-admin
CLOUD_AGENTS_TENANT_AUDIT_FACT_UID=audit-tenant-bootstrap
CLOUD_AGENTS_MEMBERSHIP_AUDIT_FACT_UID=audit-membership-bootstrap
CLOUD_AGENTS_ROLE_BINDING_AUDIT_FACT_UID=audit-role-binding-bootstrap
CLOUD_AGENTS_BOOTSTRAP_REASON_CODE=initial-bootstrap

CLOUD_AGENTS_ACCESS_GRANT_KEY_FILE=/absolute/path/to/access-grant.key
# Exactly 32 random bytes; seals kubeconfig credentials stored in Postgres.
CLOUD_AGENTS_TARGET_CREDENTIAL_KEY_FILE=/absolute/path/to/target-credential.key
CLOUD_AGENTS_DOCKER_CREDENTIALS_DIR=/absolute/path/to/docker-target-credentials
CLOUD_AGENTS_KUBERNETES_CREDENTIALS_DIR=/absolute/path/to/kubernetes-target-credentials
CLOUD_AGENTS_SSH_CREDENTIALS_DIR=/absolute/path/to/ssh-target-credentials
CLOUD_AGENTS_CONTROL_PLANE_TLS_DIR=/absolute/path/to/control-plane-tls
CLOUD_AGENTS_CONTROL_PLANE_CA=/absolute/path/to/control-plane-ca.crt
CLOUD_AGENTS_ADMIN_WEB_TLS_DIR=/absolute/path/to/admin-web-tls
CLOUD_AGENTS_USER_WEB_TLS_DIR=/absolute/path/to/user-web-tls
CLOUD_AGENTS_ADMIN_WEB_ORIGIN=https://admin.cloud-agents.example:4174
CLOUD_AGENTS_USER_WEB_ORIGIN=https://user.cloud-agents.example:4173
CLOUD_AGENTS_ACCESS_GATEWAY_TLS_DIR=/absolute/path/to/access-gateway-tls
CLOUD_AGENTS_ACCESS_GATEWAY_SSH_HOST_KEY=/absolute/path/to/access-gateway-ssh-host-key
CLOUD_AGENTS_CONTROL_PLANE_MAX_CONCURRENT_REQUESTS=128
CLOUD_AGENTS_USER_WEB_BIND=127.0.0.1:4173
CLOUD_AGENTS_ADMIN_WEB_BIND=127.0.0.1:4174
CLOUD_AGENTS_ACCESS_GATEWAY_BIND=127.0.0.1:8090
CLOUD_AGENTS_ACCESS_GATEWAY_SSH_BIND=127.0.0.1:2222

# Optional outbound customer nodes. These values are read only when
# docker-compose.remote-worker.yml is explicitly included.
CLOUD_AGENTS_REMOTE_WORKER_CA_DIR=/absolute/path/to/remote-worker-ca
CLOUD_AGENTS_REMOTE_WORKER_TRUST_DOMAIN=remote-worker.example

# Optional legacy Managed Agent compatibility. These values are read only when
# docker-compose.managed-agent.yml is explicitly included.
# Worker image builds use the official Debian mirrors by default. Override both
# values together when the deployment host needs an approved regional mirror.
CLOUD_AGENTS_DEBIAN_MIRROR=http://deb.debian.org/debian
CLOUD_AGENTS_DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
CLOUD_AGENTS_RUNTIME_ENV_FILE=/absolute/path/to/runtime.env
# Contains <tenantId>.codex.json and/or <tenantId>.claudeAgent.json.
CLOUD_AGENTS_PROVIDER_CREDENTIALS_DIR=/absolute/path/to/provider-credentials
# Each directory contains generator-produced <tenantId>.capabilities.json and
# <signingKeyId>.pub. Keep separate copies at mode 0400 for the service UIDs.
CLOUD_AGENTS_CONTROL_PLANE_CAPABILITY_MATERIALIZATION_DIR=/absolute/path/to/control-plane-capability-materialization
CLOUD_AGENTS_WORKER_CAPABILITY_MATERIALIZATION_DIR=/absolute/path/to/worker-capability-materialization
CLOUD_AGENTS_WORKER_TLS_DIR=/absolute/path/to/worker-tls
CLOUD_AGENTS_WORKER_ENDPOINT=https://worker:8091
CLOUD_AGENTS_WORKER_SPIFFE_ID=spiffe://cloud-agents.example/worker
CLOUD_AGENTS_WORKER_CLIENT_CERT=/absolute/path/to/control-plane-tls/worker-client.crt
CLOUD_AGENTS_WORKER_CLIENT_KEY=/absolute/path/to/control-plane-tls/worker-client.key
CLOUD_AGENTS_WORKER_CA=/absolute/path/to/control-plane-tls/worker-ca.crt
CLOUD_AGENTS_WORKSPACE_DIR=/absolute/path/to/runtime-workspace
CLOUD_AGENTS_WORKER_WORKSPACE_DIRECTORY=/workspace
CLOUD_AGENTS_RUNTIME_MAX_SESSIONS=4
CLOUD_AGENTS_ADMISSION_LEASE_ID=deployment-owned-lease
CLOUD_AGENTS_ADMISSION_GENERATION=1
CLOUD_AGENTS_ADMISSION_TOKEN=replace-with-a-secret
