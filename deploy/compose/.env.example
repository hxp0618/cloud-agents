# Copy to a deployment-owned env file and replace every value.
CLOUD_AGENTS_RELEASE_DIR=/absolute/path/to/platform-release
CLOUD_AGENTS_DEPLOY_DIR=/absolute/path/to/extracted/deploy
CLOUD_AGENTS_PLATFORM=linux/amd64

CLOUD_AGENTS_POSTGRES_DB=cloud_agents
CLOUD_AGENTS_POSTGRES_INSTALL_PASSWORD=replace-with-a-secret
CLOUD_AGENTS_MIGRATION_PASSWORD=replace-with-a-secret
CLOUD_AGENTS_RUNTIME_PASSWORD=replace-with-a-secret
CLOUD_AGENTS_TENANT_BOOTSTRAP_PASSWORD=replace-with-a-secret
CLOUD_AGENTS_BOOTSTRAP_DATABASE_URL=postgresql://cloud_agents_install_admin:replace-with-a-secret@postgres:5432/cloud_agents
CLOUD_AGENTS_MIGRATION_DATABASE_URL=postgresql://cloud_agents_migration:replace-with-a-secret@postgres:5432/cloud_agents
CLOUD_AGENTS_RUNTIME_DATABASE_URL=postgresql://cloud_agents_runtime_login:replace-with-a-secret@postgres:5432/cloud_agents
CLOUD_AGENTS_TENANT_BOOTSTRAP_DATABASE_URL=postgresql://cloud_agents_tenant_bootstrap:replace-with-a-secret@postgres:5432/cloud_agents

CLOUD_AGENTS_AUTH_CONFIG=/absolute/path/to/auth.json
CLOUD_AGENTS_RUNTIME_ENV_FILE=/absolute/path/to/runtime.env
CLOUD_AGENTS_CONTROL_PLANE_TLS_DIR=/absolute/path/to/control-plane-tls
CLOUD_AGENTS_WORKER_TLS_DIR=/absolute/path/to/worker-tls
CLOUD_AGENTS_WORKER_ENDPOINT=https://worker:8091
CLOUD_AGENTS_WORKER_SPIFFE_ID=spiffe://cloud-agents.example/worker
CLOUD_AGENTS_WORKER_CLIENT_CERT=/absolute/path/to/control-plane-tls/worker-client.crt
CLOUD_AGENTS_WORKER_CLIENT_KEY=/absolute/path/to/control-plane-tls/worker-client.key
CLOUD_AGENTS_WORKER_CA=/absolute/path/to/control-plane-tls/worker-ca.crt
CLOUD_AGENTS_WORKSPACE_DIR=/absolute/path/to/runtime-workspace
CLOUD_AGENTS_WORKER_WORKSPACE_DIRECTORY=/workspace
CLOUD_AGENTS_ADMISSION_LEASE_ID=deployment-owned-lease
CLOUD_AGENTS_ADMISSION_GENERATION=1
CLOUD_AGENTS_ADMISSION_TOKEN=replace-with-a-secret
