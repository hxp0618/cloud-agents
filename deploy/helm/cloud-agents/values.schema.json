{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    }
  },
  "properties": {
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlPlane", "worker", "migrate"],
      "properties": {
        "controlPlane": {
          "$ref": "#/definitions/image"
        },
        "worker": {
          "$ref": "#/definitions/image"
        },
        "migrate": {
          "$ref": "#/definitions/image"
        }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "tenantBootstrapURLKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tenantBootstrap": {
      "type": "object",
      "required": ["enabled", "secretName"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "secretName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "maxSessions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        }
      }
    },
    "controlPlane": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "const": 1
        },
        "maxConcurrentRequests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "deploymentTargets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kubernetesCredentialSecretName", "sshCredentialSecretName"],
      "properties": {
        "kubernetesCredentialSecretName": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "sshCredentialSecretName": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "const": 1
        }
      }
    }
  }
}
