{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    }
  },
  "properties": {
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlPlane", "worker", "migrate", "accessGateway", "adminWeb", "userWeb"],
      "properties": {
        "controlPlane": {
          "$ref": "#/definitions/image"
        },
        "worker": {
          "$ref": "#/definitions/image"
        },
        "migrate": {
          "$ref": "#/definitions/image"
        },
        "accessGateway": {
          "$ref": "#/definitions/image"
        },
        "adminWeb": {
          "$ref": "#/definitions/image"
        },
        "userWeb": {
          "$ref": "#/definitions/image"
        }
      }
    },
    "accessGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secretName", "key"],
      "properties": {
        "secretName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "tenantBootstrapURLKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tenantBootstrap": {
      "type": "object",
      "required": ["enabled", "secretName"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "secretName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "maxSessions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        }
      }
    },
    "controlPlane": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "const": 1
        },
        "maxConcurrentRequests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "deploymentTargets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kubernetesCredentialSecretName", "sshCredentialSecretName"],
      "properties": {
        "kubernetesCredentialSecretName": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "sshCredentialSecretName": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        }
      }
    },
    "remoteWorker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certificateAuthoritySecretName", "trustDomain"],
      "properties": {
        "certificateAuthoritySecretName": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "trustDomain": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        }
      },
      "oneOf": [
        {
          "properties": {
            "certificateAuthoritySecretName": { "const": "" },
            "trustDomain": { "const": "" }
          }
        },
        {
          "properties": {
            "certificateAuthoritySecretName": {
              "minLength": 1
            },
            "trustDomain": {
              "minLength": 1
            }
          }
        }
      ]
    },
    "worker": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "accessGateway": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "const": 1
        },
        "sshHostKeySecretName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "sshHostKeyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      }
    },
    "adminWeb": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "const": 1
        },
        "controlPlaneCASecretName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "controlPlaneCAKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      }
    },
    "userWeb": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "const": 1
        },
        "controlPlaneCASecretName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "controlPlaneCAKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      }
    }
  }
}
