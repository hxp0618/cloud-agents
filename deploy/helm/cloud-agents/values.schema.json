{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "database": {
      "type": "object",
      "properties": {
        "tenantBootstrapURLKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tenantBootstrap": {
      "type": "object",
      "required": ["enabled", "secretName"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "secretName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "controlPlane": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "const": 1
        }
      }
    }
  }
}
