{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/docs/acceptance/public-evidence-mirror-v1.schema.json",
  "title": "Cloud Agents public evidence mirror v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "formatVersion",
    "status",
    "sourceInputs",
    "output",
    "sanitization",
    "omittedHistoricalObjects"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://schemas.cloud-agents.dev/docs/acceptance/public-evidence-mirror-v1.schema.json"
    },
    "formatVersion": { "type": "string", "const": "cloud-agents-public-evidence-mirror/v1" },
    "status": { "type": "string", "const": "SANITIZED_PUBLIC_MIRROR" },
    "sourceInputs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/fileBinding" },
            { "properties": { "path": { "const": "docs/acceptance/phase-1.md" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/fileBinding" },
            {
              "properties": {
                "path": { "const": "docs/plan/cloud-agents-platform/06-status-tracker.md" }
              }
            }
          ]
        }
      ],
      "items": false
    },
    "output": {
      "allOf": [
        { "$ref": "#/$defs/fileBinding" },
        { "properties": { "path": { "const": "docs/acceptance/phase-1.public.md" } } }
      ]
    },
    "sanitization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "replacementRules", "sourcePreserved", "publicLinksNormalized"],
      "properties": {
        "profile": { "type": "string", "const": "public-evidence-mirror/v1" },
        "sourcePreserved": { "type": "boolean", "const": true },
        "publicLinksNormalized": { "type": "integer", "minimum": 0 },
        "replacementRules": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "prefixItems": [
            { "allOf": [{ "$ref": "#/$defs/replacementRule" }, { "properties": { "id": { "const": "host-path" } } }] },
            { "allOf": [{ "$ref": "#/$defs/replacementRule" }, { "properties": { "id": { "const": "tmp-artifact" } } }] },
            { "allOf": [{ "$ref": "#/$defs/replacementRule" }, { "properties": { "id": { "const": "pod-cidr" } } }] },
            { "allOf": [{ "$ref": "#/$defs/replacementRule" }, { "properties": { "id": { "const": "service-cidr" } } }] },
            { "allOf": [{ "$ref": "#/$defs/replacementRule" }, { "properties": { "id": { "const": "cluster-cidr-summary" } } }] },
            { "allOf": [{ "$ref": "#/$defs/replacementRule" }, { "properties": { "id": { "const": "pod-ip" } } }] },
            { "allOf": [{ "$ref": "#/$defs/replacementRule" }, { "properties": { "id": { "const": "service-ip" } } }] },
            { "allOf": [{ "$ref": "#/$defs/replacementRule" }, { "properties": { "id": { "const": "vm-ip" } } }] },
            { "allOf": [{ "$ref": "#/$defs/replacementRule" }, { "properties": { "id": { "const": "private-ip" } } }] },
            { "allOf": [{ "$ref": "#/$defs/replacementRule" }, { "properties": { "id": { "const": "loopback-endpoint" } } }] },
            { "allOf": [{ "$ref": "#/$defs/replacementRule" }, { "properties": { "id": { "const": "kubernetes-api-endpoint" } } }] },
            { "allOf": [{ "$ref": "#/$defs/replacementRule" }, { "properties": { "id": { "const": "credential-path" } } }] },
            { "allOf": [{ "$ref": "#/$defs/replacementRule" }, { "properties": { "id": { "const": "provider-token-env" } } }] }
          ],
          "items": false
        }
      }
    },
    "omittedHistoricalObjects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patterns", "count", "source", "reason"],
      "properties": {
        "patterns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "count": { "type": "integer", "minimum": 0 },
        "source": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "sizeBytes", "gitMode"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\]+(?:/[^/\\\\]+)*$"
        },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "gitMode": { "type": "string", "pattern": "^100[0-7]{3}$" }
      }
    },
    "replacementRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "replacement", "count"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "replacement": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
