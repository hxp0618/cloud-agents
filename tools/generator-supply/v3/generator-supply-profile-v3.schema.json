{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/tooling/generator-supply/v3/generator-supply-profile-v3.schema.json",
  "title": "Cloud Agents generated generator supply profile v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "registryId",
    "predecessor",
    "sourceDigest",
    "artifactSetDigest",
    "evidenceManifestDigest",
    "profile",
    "registryDigest"
  ],
  "properties": {
    "formatVersion": {
      "const": "cloud-agents-generator-supply-profile-registry/v3"
    },
    "registryId": {
      "const": "cloud-agents/generator-supply-profile"
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baselineCommit",
        "baselineTree",
        "predecessorClosureDigest"
      ],
      "properties": {
        "baselineCommit": {
          "const": "16275f6cbf390c343a9ac00f9193e75eaad0094e"
        },
        "baselineTree": {
          "const": "ca595b8e1258a8b78c4da3a545b2a31d8f62b531"
        },
        "predecessorClosureDigest": {
          "$ref": "#/$defs/prefixedDigest"
        }
      }
    },
    "sourceDigest": {
      "$ref": "#/$defs/prefixedDigest"
    },
    "artifactSetDigest": {
      "$ref": "#/$defs/prefixedDigest"
    },
    "evidenceManifestDigest": {
      "$ref": "#/$defs/prefixedDigest"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileDigest",
        "spec",
        "evidence"
      ],
      "properties": {
        "profileDigest": {
          "$ref": "#/$defs/prefixedDigest"
        },
        "spec": {
          "$ref": "generator-supply-profile-source-v3.schema.json#/$defs/profile"
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "receipts",
            "evidenceManifest"
          ],
          "properties": {
            "state": {
              "const": "ASSEMBLED_LATE_BOUND"
            },
            "receipts": {
              "type": "array",
              "minItems": 8,
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/fileRecord"
              }
            },
            "evidenceManifest": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "algorithm",
                "files"
              ],
              "properties": {
                "algorithm": {
                  "const": "sorted-path-nul-sha256-nul-size-v1"
                },
                "files": {
                  "type": "array",
                  "minItems": 8,
                  "maxItems": 8,
                  "items": {
                    "$ref": "#/$defs/fileRecord"
                  }
                }
              }
            }
          }
        }
      }
    },
    "registryDigest": {
      "$ref": "#/$defs/prefixedDigest"
    }
  },
  "$defs": {
    "prefixedDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "v3EvidencePath": {
      "type": "string",
      "pattern": "^tools/generator-supply/v3/evidence/replay(?:/[A-Za-z0-9._-]+\\.json|\\.json)$"
    },
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "sizeBytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/v3EvidencePath"
        },
        "sha256": {
          "$ref": "#/$defs/prefixedDigest"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
