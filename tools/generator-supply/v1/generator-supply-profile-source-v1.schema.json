{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/tooling/generator-supply/v1/generator-supply-profile-source-v1.schema.json",
  "title": "Cloud Agents generator supply profile source v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "profile"],
  "properties": {
    "formatVersion": { "const": "cloud-agents-generator-supply-profile-source/v1" },
    "profile": { "$ref": "#/$defs/profile" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "filename", "source", "sha256", "sizeBytes", "use"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
        "filename": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9+._-]+$" },
        "source": { "type": "string", "pattern": "^https://" },
        "sha256": { "$ref": "#/$defs/digest" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "use": { "enum": ["GENERATOR_RUNTIME", "EVIDENCE_ONLY"] }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "nativeExecution", "npmInstalledPackages"],
      "properties": {
        "id": { "enum": ["darwin-arm64", "linux-amd64", "linux-arm64"] },
        "status": { "enum": ["NATIVE_REPLAY_VERIFIED", "NOT_CLAIMED"] },
        "nativeExecution": { "type": "boolean" },
        "npmInstalledPackages": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material", "replay", "sbom", "notice", "vulnerability"],
      "properties": {
        "material": { "$ref": "#/$defs/pathArray" },
        "replay": { "$ref": "#/$defs/pathArray" },
        "sbom": { "$ref": "#/$defs/pathArray" },
        "notice": { "$ref": "#/$defs/pathArray" },
        "vulnerability": { "$ref": "#/$defs/pathArray" }
      }
    },
    "pathArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^tools/generator-supply/v1/evidence/[A-Za-z0-9][A-Za-z0-9/._-]+$"
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "status",
        "notGateClosure",
        "platforms",
        "runtimes",
        "officialArtifacts",
        "dependencyAuthority",
        "replayAuthority",
        "evidence",
        "attestation",
        "boundaries"
      ],
      "properties": {
        "profileId": { "const": "cloud-agents/generator-supply-profile/v1" },
        "status": { "const": "REPLAY_VERIFIED_REVIEW_PENDING" },
        "notGateClosure": { "const": true },
        "platforms": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/platform" }
        },
        "runtimes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node",
            "npm",
            "bun",
            "go",
            "gofmt",
            "python",
            "pythonBuild",
            "uv",
            "protoc",
            "protocGenGo",
            "protocGenConnectGo",
            "protocGenES",
            "oxfmt"
          ],
          "properties": {
            "node": { "const": "24.18.1" },
            "npm": { "const": "11.8.0" },
            "bun": { "const": "1.3.14" },
            "go": { "const": "1.26.6" },
            "gofmt": { "const": "1.26.6-sibling" },
            "python": { "const": "3.14.7" },
            "pythonBuild": { "const": "astral-20260814" },
            "uv": { "const": "0.12.5" },
            "protoc": { "const": "35.1" },
            "protocGenGo": { "const": "1.36.12" },
            "protocGenConnectGo": { "const": "1.20.0" },
            "protocGenES": { "const": "2.14.0" },
            "oxfmt": { "const": "0.62.0" }
          }
        },
        "officialArtifacts": {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "dependencyAuthority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["npm", "go", "python", "rootBunLock"],
          "properties": {
            "npm": { "const": "STERILE_NPM_11_8_0_OFFICIAL_REGISTRY_EXACT_LOCK" },
            "go": { "const": "ISOLATED_GO_MOD_SUM_EXACT_MODULES" },
            "python": { "const": "UV_OFFLINE_21_WHEELS_PER_PLATFORM" },
            "rootBunLock": { "const": "LEGACY_NPMMIRROR_CONTEXT_NOT_EXECUTION_AUTHORITY" }
          }
        },
        "replayAuthority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wrapperPolicy",
            "wrapperPath",
            "wrapperSha256",
            "runnerPath",
            "runnerSha256",
            "pathAuthorityPath",
            "pathAuthoritySha256",
            "replayArchiveInspectorPath",
            "replayArchiveInspectorSha256",
            "projectionPolicy",
            "projectionArchiveFormat",
            "projectionArchiveByteBinding",
            "projectionArchiveMemberManifestAlgorithm",
            "inputTreeManifestAlgorithm",
            "nodeModulesManifestAlgorithm",
            "authoritativeReplayScope",
            "isolationEvidenceAuthority"
          ],
          "properties": {
            "wrapperPolicy": { "const": "VERSIONED_ISOLATION_WRAPPER_V1" },
            "wrapperPath": { "const": "scripts/replay-platform-generators-isolated.sh" },
            "wrapperSha256": { "$ref": "#/$defs/digest" },
            "runnerPath": { "const": "scripts/replay-platform-generators.ts" },
            "runnerSha256": { "$ref": "#/$defs/digest" },
            "pathAuthorityPath": {
              "const": "scripts/lib/generator-replay-path-authority.ts"
            },
            "pathAuthoritySha256": { "$ref": "#/$defs/digest" },
            "replayArchiveInspectorPath": {
              "const": "scripts/lib/inspect-generator-replay-archive.py"
            },
            "replayArchiveInspectorSha256": { "$ref": "#/$defs/digest" },
            "projectionPolicy": { "const": "ACYCLIC_CORE_PROJECTION_V1" },
            "projectionArchiveFormat": { "const": "GIT_ARCHIVE_TAR_FIXED_MTIME_1970" },
            "projectionArchiveByteBinding": { "const": "SHA256_AND_SIZE_BYTES_EXACT" },
            "projectionArchiveMemberManifestAlgorithm": {
              "const": "utf8-bytewise-sorted-path-type-mode-size-sha256-linktarget-nul-v1"
            },
            "inputTreeManifestAlgorithm": {
              "const": "utf8-bytewise-sorted-path-mode-size-sha256-nul-v1"
            },
            "nodeModulesManifestAlgorithm": {
              "const": "utf8-bytewise-sorted-path-nul-sha256-nul-git-mode-v1"
            },
            "authoritativeReplayScope": {
              "const": "CORE_GENERATORS_ONLY_SUPPLY_PROFILE_AND_LOCK_POST_ASSEMBLY"
            },
            "isolationEvidenceAuthority": {
              "const": "VERSIONED_WRAPPER_SAME_BOUNDARY_RECEIPT"
            }
          }
        },
        "evidence": { "$ref": "#/$defs/evidence" },
        "attestation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "semantics",
            "cryptographicSignature",
            "signerIdentityAuthentication",
            "publication"
          ],
          "properties": {
            "semantics": { "const": "DETACHED_DIGEST_BOUND_INDEPENDENT_REVIEW" },
            "cryptographicSignature": { "const": "NOT_PRODUCED_NOT_AUTHORIZED" },
            "signerIdentityAuthentication": { "const": "NOT_CLAIMED" },
            "publication": { "const": "NOT_AUTHORIZED" }
          }
        },
        "boundaries": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "criterion",
            "gate",
            "productionDatabase",
            "http",
            "p2",
            "provider",
            "deployment",
            "release",
            "legalApproval"
          ],
          "properties": {
            "criterion": { "const": "REVIEW_PENDING_NOT_CLOSED" },
            "gate": { "const": "ALL_GATES_OPEN" },
            "productionDatabase": { "const": "NOT_AUTHORIZED" },
            "http": { "const": "NOT_IMPLEMENTED" },
            "p2": { "const": "NOT_IMPLEMENTED" },
            "provider": { "const": "NOT_AUTHORIZED" },
            "deployment": { "const": "NOT_AUTHORIZED" },
            "release": { "const": "NOT_AUTHORIZED" },
            "legalApproval": { "const": "NOT_CLAIMED" }
          }
        }
      }
    }
  }
}
