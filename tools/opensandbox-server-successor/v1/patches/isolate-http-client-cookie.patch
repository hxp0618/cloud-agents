+def _bind_endpoint_cookie_authority(
+    request: httpx.Request, headers: Mapping[str, str]
+) -> None:
+    """Discard process-scoped cookie-jar state while preserving endpoint authority."""
+    cookie = httpx.Headers(headers).get("cookie")
+    if cookie is None:
+        request.headers.pop("cookie", None)
+        return
+    request.headers["cookie"] = cookie
+
