+func TestPTYSession_TerminalDoneFollowsReplayDrain(t *testing.T) {
+	if _, err := exec.LookPath("bash"); err != nil {
+		t.Skip("bash not found")
+	}
+
+	const outputSize = 512 << 10
+	tail := []byte("terminal_tail_marker")
+	expected := append(make([]byte, outputSize), tail...)
+	expectedHash := sha256.Sum256(expected)
+	for _, mode := range []string{"pipe", "pty"} {
+		t.Run(mode, func(t *testing.T) {
+			s := newPTYSession(uuidString(), "", "dd if=/dev/zero bs=4096 count=128 2>/dev/null; printf terminal_tail_marker; exit 7")
+			if mode == "pipe" {
+				require.NoError(t, s.StartPipe())
+			} else {
+				require.NoError(t, s.StartPTY())
+			}
+			t.Cleanup(func() { s.close() })
+
+			select {
+			case <-s.Done():
+			case <-time.After(10 * time.Second):
+				t.Fatal("timed out waiting for terminal session")
+			}
+
+			actual, offset := s.replay.ReadFrom(0)
+			actualHash := sha256.Sum256(actual)
+			require.Equal(t, int64(0), offset)
+			require.Equal(t, len(expected), len(actual), "Done must follow complete replay drain")
+			require.True(t, bytes.Equal(expectedHash[:], actualHash[:]), "terminal replay bytes must be exact")
+			require.Equal(t, 7, s.ExitCode())
+			require.True(t, s.OutputComplete())
+		})
+	}
+}
+
+func TestPTYSession_TerminalAttachHasClosedLiveSinks(t *testing.T) {
+	s := newPTYSession(uuidString(), "", "printf terminal; exit 7")
+	require.NoError(t, s.StartPipe())
+	t.Cleanup(func() { s.close() })
+	select {
+	case <-s.Done():
+	case <-time.After(10 * time.Second):
+		t.Fatal("timed out waiting for terminal session")
+	}
+
+	stdoutR, stderrR, detach, replay, _ := s.AttachOutputWithSnapshot(0)
+	defer detach()
+	require.Equal(t, "terminal", string(replay))
+	stdout, err := io.ReadAll(stdoutR)
+	require.NoError(t, err)
+	require.Empty(t, stdout)
+	stderr, err := io.ReadAll(stderrR)
+	require.NoError(t, err)
+	require.Empty(t, stderr)
+}
+
+func TestPTYSession_TerminalCleanupKillsDescendants(t *testing.T) {
+	for _, mode := range []string{"pipe", "pty"} {
+		t.Run(mode, func(t *testing.T) {
+			pidFile := t.TempDir() + "/child.pid"
+			command := fmt.Sprintf("(trap '' HUP; sleep 300) & echo $! > %q; exit 7", pidFile)
+			s := newPTYSession(uuidString(), "", command)
+			if mode == "pipe" {
+				require.NoError(t, s.StartPipe())
+			} else {
+				require.NoError(t, s.StartPTY())
+			}
+			t.Cleanup(func() { s.close() })
+			select {
+			case <-s.Done():
+			case <-time.After(time.Second):
+				t.Fatal("output drain timeout did not bound inherited output lifetime")
+			}
+			require.Equal(t, 7, s.ExitCode())
+			running, exitCode := s.status()
+			require.False(t, running)
+			if s.OutputComplete() {
+				require.NotNil(t, exitCode)
+				require.Equal(t, 7, *exitCode)
+			} else {
+				require.Nil(t, exitCode, "incomplete output must not expose an authoritative exit")
+			}
+
+			rawPID, err := os.ReadFile(pidFile)
+			require.NoError(t, err)
+			childPID, err := strconv.Atoi(strings.TrimSpace(string(rawPID)))
+			require.NoError(t, err)
+			require.Eventually(t, func() bool {
+				return syscall.Kill(childPID, 0) == syscall.ESRCH
+			}, time.Second, 10*time.Millisecond, "descendant process %d survived terminal cleanup", childPID)
+		})
+	}
+}
