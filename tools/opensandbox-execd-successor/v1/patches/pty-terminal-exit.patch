+func TestPTYWS_TerminalReconnectReplaysExactExitWithoutRestart(t *testing.T) {
+	if _, err := exec.LookPath("bash"); err != nil {
+		t.Skip("bash not found")
+	}
+	for _, code := range []int{0, 7} {
+		t.Run(fmt.Sprintf("exit_%d", code), func(t *testing.T) {
+			srv := newPTYTestServer(t)
+			defer srv.Close()
+			marker := fmt.Sprintf("terminal_once_%d", code)
+			body := fmt.Sprintf(`{"command":"printf %s; exit %d"}`, marker, code)
+			id := ptyCreateSessionWithBody(t, srv, body)
+			conn1 := wsDialPTY(t, srv.URL, "/pty/"+id+"/ws", "pty=0")
+			ptyWaitFrame(t, conn1, "connected", 10*time.Second)
+			ptyOutputContains(t, conn1, marker, 8*time.Second)
+			exit1 := ptyWaitFrame(t, conn1, "exit", 10*time.Second)
+			require.NotNil(t, exit1.ExitCode)
+			require.Equal(t, code, *exit1.ExitCode)
+			require.NoError(t, conn1.Close())
+
+			resp, err := http.Get(srv.URL + "/pty/" + id)
+			require.NoError(t, err)
+			defer resp.Body.Close()
+			var status map[string]any
+			require.NoError(t, json.NewDecoder(resp.Body).Decode(&status))
+			require.Equal(t, false, status["running"])
+			require.Equal(t, float64(code), status["exit_code"])
+
+			conn2 := wsDialPTY(t, srv.URL, "/pty/"+id+"/ws", "pty=0&since=0&takeover=1")
+			replay, err := ptyReadFrame(conn2, 10*time.Second)
+			require.NoError(t, err)
+			require.Equal(t, "replay", replay.Type)
+			require.Contains(t, replay.Data, marker)
+			connected, err := ptyReadFrame(conn2, 10*time.Second)
+			require.NoError(t, err)
+			require.Equal(t, "connected", connected.Type)
+			exit2, err := ptyReadFrame(conn2, 10*time.Second)
+			require.NoError(t, err)
+			require.Equal(t, "exit", exit2.Type)
+			require.NotNil(t, exit2.ExitCode)
+			require.Equal(t, code, *exit2.ExitCode)
+		})
+	}
+}
