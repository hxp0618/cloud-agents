+func TestPTYWS_TerminalReconnectReplaysCompleteTail(t *testing.T) {
+	if _, err := exec.LookPath("bash"); err != nil {
+		t.Skip("bash not found")
+	}
+
+	const outputSize = 512 << 10
+	tail := []byte("terminal_tail_marker")
+	expected := append(make([]byte, outputSize), tail...)
+	expectedHash := sha256.Sum256(expected)
+	body, err := json.Marshal(map[string]string{
+		"command": "dd if=/dev/zero bs=4096 count=128 2>/dev/null; printf terminal_tail_marker; exit 7",
+	})
+	require.NoError(t, err)
+	for _, mode := range []string{"pipe", "pty"} {
+		t.Run(mode, func(t *testing.T) {
+			srv := newPTYTestServer(t)
+			defer srv.Close()
+			id := ptyCreateSessionWithBody(t, srv, string(body))
+			query := ""
+			if mode == "pipe" {
+				query = "pty=0"
+			}
+
+			conn1 := wsDialPTY(t, srv.URL, "/pty/"+id+"/ws", query)
+			ptyWaitFrame(t, conn1, "connected", 10*time.Second)
+			require.NoError(t, conn1.Close())
+
+			require.Eventually(t, func() bool {
+				resp, getErr := http.Get(srv.URL + "/pty/" + id)
+				if getErr != nil {
+					return false
+				}
+				defer resp.Body.Close()
+				var status map[string]any
+				return json.NewDecoder(resp.Body).Decode(&status) == nil && status["exit_code"] == float64(7)
+			}, 10*time.Second, 10*time.Millisecond)
+
+			reconnectQuery := "since=0&takeover=1"
+			if mode == "pipe" {
+				reconnectQuery += "&pty=0"
+			}
+			conn2 := wsDialPTY(t, srv.URL, "/pty/"+id+"/ws", reconnectQuery)
+			replay, err := ptyReadFrame(conn2, 10*time.Second)
+			require.NoError(t, err)
+			require.Equal(t, "replay", replay.Type)
+			actual := []byte(replay.Data)
+			actualHash := sha256.Sum256(actual)
+			require.Equal(t, len(expected), len(actual))
+			require.True(t, bytes.Equal(expectedHash[:], actualHash[:]), "terminal replay bytes must be exact")
+			require.Equal(t, "connected", ptyWaitFrame(t, conn2, "connected", 10*time.Second).Type)
+			exit := ptyWaitFrame(t, conn2, "exit", 10*time.Second)
+			require.NotNil(t, exit.ExitCode)
+			require.Equal(t, 7, *exit.ExitCode)
+		})
+	}
+}
