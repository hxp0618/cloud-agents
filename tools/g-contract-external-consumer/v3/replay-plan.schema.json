{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/tools/g-contract-external-consumer/v3/replay-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "formatVersion", "decisionId", "profileId", "status", "sourceBinding", "successorBinding", "receiptPaths", "platformRuns", "writeMode", "syntheticReceipts", "network", "externalEgress", "notGateClosure", "gateStatus"],
  "properties": {
    "$schema": { "const": "https://schemas.cloud-agents.dev/tools/g-contract-external-consumer/v3/replay-plan.schema.json" },
    "formatVersion": { "const": "cloud-agents-g-contract-external-consumer-replay-plan/v3" },
    "decisionId": { "const": "D-053-EC-3" },
    "profileId": { "const": "g-contract-external-consumer/v3" },
    "status": { "const": "REPLAY_PENDING" },
    "sourceBinding": { "$ref": "#/$defs/file" },
    "successorBinding": { "$ref": "#/$defs/successor" },
    "receiptPaths": { "const": ["tools/g-contract-external-consumer/v3/evidence/replay/projection.json", "tools/g-contract-external-consumer/v3/evidence/replay/darwin-arm64-a.json", "tools/g-contract-external-consumer/v3/evidence/replay/darwin-arm64-b.json", "tools/g-contract-external-consumer/v3/evidence/replay/linux-amd64-a.json", "tools/g-contract-external-consumer/v3/evidence/replay/linux-amd64-b.json", "tools/g-contract-external-consumer/v3/evidence/replay/replay.json"] },
    "platformRuns": { "const": [{ "platform": "darwin-arm64", "runId": "A" }, { "platform": "darwin-arm64", "runId": "B" }, { "platform": "linux-amd64", "runId": "A" }, { "platform": "linux-amd64", "runId": "B" }] },
    "writeMode": { "const": "READ_ONLY" },
    "syntheticReceipts": { "const": "FORBIDDEN" },
    "network": { "const": "LOOPBACK_ONLY" },
    "externalEgress": { "const": "DENIED" },
    "notGateClosure": { "const": true },
    "gateStatus": { "const": "ALL_GATES_OPEN" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "file": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "sizeBytes"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/digest" }, "sizeBytes": { "type": "integer", "minimum": 1 } } },
    "successor": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "sizeBytes", "outputCount", "outputManifestSha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/digest" }, "sizeBytes": { "type": "integer", "minimum": 1 }, "outputCount": { "const": 47 }, "outputManifestSha256": { "$ref": "#/$defs/digest" } } }
  }
}
