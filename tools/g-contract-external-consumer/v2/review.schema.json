{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/tools/g-contract-external-consumer/v2/review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "decisionId",
    "profileId",
    "reviewKind",
    "candidate",
    "reviewTip",
    "changedPaths",
    "reviewInput",
    "checks",
    "findings",
    "decision",
    "gateEffect"
  ],
  "properties": {
    "formatVersion": { "const": "cloud-agents-g-contract-external-consumer-independent-review/v2" },
    "decisionId": { "const": "D-053-EC-2" },
    "profileId": { "const": "g-contract-external-consumer/v2" },
    "reviewKind": { "enum": ["AUTHORITY", "FINAL_REPLAY_PROFILE"] },
    "candidate": { "$ref": "#/$defs/commitTuple" },
    "reviewTip": { "$ref": "#/$defs/commitTuple" },
    "changedPaths": {
      "const": ["docs/plan/p1/g-contract-external-consumer-v2-independent-review-20260826.md"]
    },
    "reviewInput": {
      "enum": ["FROZEN_SOURCE_SCHEMA_AUTHORITY_BYTES_ONLY", "FROZEN_SOURCE_PROFILE_RECEIPTS_ONLY"]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "const": "PASS" },
          "evidence": { "type": "string" }
        }
      }
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["P0", "P1", "P2"],
      "properties": {
        "P0": { "type": "integer", "minimum": 0 },
        "P1": { "type": "integer", "minimum": 0 },
        "P2": { "type": "integer", "minimum": 0 }
      }
    },
    "decision": { "enum": ["APPROVE", "REQUEST_CHANGES"] },
    "gateEffect": { "const": "NO_GATE_CLOSURE" },
    "notGateClosure": { "const": true }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "commitTuple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "parent"],
      "properties": {
        "commit": { "$ref": "#/$defs/sha1" },
        "tree": { "$ref": "#/$defs/sha1" },
        "parent": { "$ref": "#/$defs/sha1" }
      }
    }
  }
}
