    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "gitBlob", "sha256", "sizeBytes", "mode"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?:sdk|contracts|docs|scripts|tools)/[A-Za-z0-9._/-]+$"
        },
        "gitBlob": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sha256": { "$ref": "#/$defs/digest" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "mode": { "const": "100644" }
      }
