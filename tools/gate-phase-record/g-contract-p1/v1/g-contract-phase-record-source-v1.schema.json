  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "formalCriteria",
        "missingStatus"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "formalCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "missingStatus": {
          "enum": [
            "OPEN_NOT_CLAIMED",
            "REVIEW_PENDING"
          ]
        }
      }
    },
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "path",
        "sha256",
        "status"
      ],
      "properties": {
        "evidenceId": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "status": {
          "const": "VERIFIED"
        }
      }
    },
    "historical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "path",
        "sha256"
      ],
      "properties": {
        "evidenceId": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "reviewSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "candidateSubjectPath",
        "reviewPath",
        "candidateDiffDomain",
        "reviewDiffDomain",
        "requiredVerdict"
      ],
      "properties": {
        "subject": {
          "enum": [
            "generator_supply_v3",
            "g_contract_r5"
          ]
        },
        "candidateSubjectPath": {
          "$ref": "#/$defs/path"
        },
        "reviewPath": {
          "$ref": "#/$defs/path"
        },
        "candidateDiffDomain": {
          "type": "string",
          "minLength": 1
        },
        "reviewDiffDomain": {
          "type": "string",
          "minLength": 1
        },
        "requiredVerdict": {
          "const": "APPROVE_P0_0_P1_0_P2_0"
        }
      }
    },
    "exact17": {
      "const": [
        "contracts/generation.lock.json",
        "tools/generator-supply/v3/evidence-manifest.json",
        "tools/generator-supply/v3/profile.json",
