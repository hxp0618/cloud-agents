{
  "schemaVersion": 1,
  "id": "dev.cloud-agent.portable-runtime",
  "displayName": "Cloud Agent Portable Runtime",
  "distributionVersion": "0.1.0-rc.1",
  "releaseState": "source",
  "protocol": "2.3",
  "runtimeProtocol": { "major": 2, "minor": 3 },
  "runtimeEvent": 2,
  "runtimeEventVersions": { "minimum": 2, "maximum": 2 },
  "providerPluginAbi": 1,
  "runtime": { "package": "@cloud-agents/cloud-agent-runtime", "version": "0.2.0-rc.1" },
  "providers": [
    {
      "kind": "codex",
      "package": "@cloud-agents/cloud-agent-provider-codex",
      "version": "0.1.0-rc.1"
    },
    {
      "kind": "claudeAgent",
      "package": "@cloud-agents/cloud-agent-provider-claude",
      "version": "0.1.0-rc.1"
    },
    {
      "kind": "pi",
      "package": "@cloud-agents/cloud-agent-provider-pi",
      "version": "0.1.0-rc.1",
      "upstream": { "package": "@earendil-works/pi-coding-agent", "version": "0.85.1" }
    },
    {
      "kind": "deepseek-harness",
      "package": "@cloud-agents/cloud-agent-provider-deepseek-harness",
      "version": "0.1.0-rc.1",
      "upstream": { "package": "@deepseek-ai/dsh-sdk-client", "version": "0.1.2-rc.1" }
    }
  ],
  "entrypoints": { "node": "./dist/index.mjs", "stdio": "./dist/stdio.mjs" },
  "schemas": {
    "cloudAgentEnvelopeV2": "./schemas/cloud-agent-envelope-v2"
  },
  "permissions": [
    "spawn-provider-process",
    "read-host-workspace",
    "write-host-workspace",
    "emit-artifact-candidates"
  ],
  "credentialDelivery": ["anonymous-fd"],
  "releaseDigest": null
}
