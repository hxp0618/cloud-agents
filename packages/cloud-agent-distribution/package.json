{
  "name": "@synara/cloud-agent-distribution",
  "version": "0.1.0-rc.1",
  "description": "Pinned Cloud Agent runtime distribution for Synara and T3 Code hosts",
  "homepage": "https://github.com/hxp0618/cloud-agents#readme",
  "bugs": {
    "url": "https://github.com/hxp0618/cloud-agents/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hxp0618/cloud-agents.git",
    "directory": "packages/cloud-agent-distribution"
  },
  "bin": {
    "cloud-agent-runtime": "./dist/stdio.mjs"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts",
    "manifest.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./manifest.json": "./manifest.json",
    "./schemas": {
      "types": "./src/schemas.ts",
      "bun": "./src/schemas.ts",
      "development": "./src/schemas.ts",
      "import": "./dist/schemas.mjs",
      "require": "./dist/schemas.cjs"
    },
    "./schemas/cloud-agent-envelope-v2": {
      "types": "./src/schemas.ts",
      "bun": "./src/schemas.ts",
      "development": "./src/schemas.ts",
      "import": "./dist/schemas.mjs",
      "require": "./dist/schemas.cjs"
    },
    "./stdio": {
      "bun": "./src/stdio.ts",
      "development": "./src/stdio.ts",
      "import": "./dist/stdio.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown src/index.ts src/schemas.ts --format esm,cjs --dts --clean && bun build src/stdio.ts --target=node --outfile=dist/stdio.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@synara/cloud-agent-protocol": "0.1.0-rc.1",
    "@synara/cloud-agent-provider-api": "0.1.0-rc.1",
    "@synara/cloud-agent-provider-claude": "0.1.0-rc.1",
    "@synara/cloud-agent-provider-codex": "0.1.0-rc.1",
    "@synara/cloud-agent-runtime": "0.2.0-rc.1"
  },
  "devDependencies": {
    "tsdown": "0.20.3",
    "typescript": "5.7.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.13.1 <25"
  }
}
