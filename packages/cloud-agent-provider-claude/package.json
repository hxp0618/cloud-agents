{
  "name": "@synara/cloud-agent-provider-claude",
  "version": "0.1.0-rc.1",
  "description": "Host-neutral Claude provider plugin for the Synara Cloud Agent runtime",
  "homepage": "https://github.com/hxp0618/cloud-agents#readme",
  "bugs": {
    "url": "https://github.com/hxp0618/cloud-agents/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hxp0618/cloud-agents.git",
    "directory": "packages/cloud-agent-provider-claude"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "development": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm,cjs --dts --clean --no-fail-on-warn",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.207"
  },
  "devDependencies": {
    "tsdown": "0.20.3",
    "typescript": "5.7.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@synara/cloud-agent-provider-api": "0.1.0-rc.1"
  },
  "engines": {
    "node": ">=24.13.1 <25"
  }
}
