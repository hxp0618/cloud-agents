{
  "name": "@cloud-agents/cloud-agent-provider-pi",
  "version": "0.1.0-rc.1",
  "description": "Host-neutral Pi provider plugin for the Cloud Agents Runtime",
  "homepage": "https://github.com/hxp0618/cloud-agents#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hxp0618/cloud-agents.git",
    "directory": "packages/cloud-agent-provider-pi"
  },
  "files": ["dist", "src", "!src/**/*.test.ts", "README.md", "LICENSE"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "development": "./src/index.ts",
      "import": { "types": "./dist/index.d.mts", "default": "./dist/index.mjs" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": {
    "build": "tsdown src/index.ts --format esm,cjs --dts --clean --no-fail-on-warn",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": { "@earendil-works/pi-coding-agent": "0.85.1" },
  "devDependencies": { "tsdown": "0.20.3", "typescript": "5.7.3", "vitest": "4.1.10" },
  "peerDependencies": { "@cloud-agents/cloud-agent-provider-api": "0.1.0-rc.1" },
  "engines": { "node": ">=24.18.1 <25" }
}
