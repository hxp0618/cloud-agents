{
  "name": "@synara/cloud-agent-provider-api",
  "version": "0.1.0-rc.1",
  "description": "Host-neutral Cloud Agent provider plugin ABI",
  "homepage": "https://github.com/hxp0618/cloud-agents#readme",
  "bugs": {
    "url": "https://github.com/hxp0618/cloud-agents/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hxp0618/cloud-agents.git",
    "directory": "packages/cloud-agent-provider-api"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "development": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./internal": {
      "bun": "./src/internal.ts",
      "development": "./src/internal.ts",
      "import": {
        "types": "./dist/internal.d.mts",
        "default": "./dist/internal.mjs"
      },
      "require": {
        "types": "./dist/internal.d.cts",
        "default": "./dist/internal.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm,cjs --dts --clean && tsdown src/internal.ts --format esm,cjs --dts --no-clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsdown": "0.20.3",
    "typescript": "5.7.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@synara/cloud-agent-protocol": "0.1.0-rc.1"
  },
  "engines": {
    "node": ">=20.3.0"
  }
}
