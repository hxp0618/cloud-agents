{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/platform/migrations/successor/000014/authority-source.schema.json",
  "title": "Durable Project create migration successor authority source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "formatVersion",
    "authorityId",
    "revision",
    "successorId",
    "inputScope",
    "schemaDescriptor",
    "profileDescriptor",
    "predecessor",
    "successor",
    "inputPaths",
    "protectedPaths",
    "exclusionPaths",
    "archiveAlgorithm",
    "memberAlgorithm",
    "receiptPaths",
    "receiptState",
    "runner",
    "toolchain",
    "platforms",
    "lineageFence",
    "reviewRules",
    "implementationBoundary"
  ],
  "properties": {
    "$schema": {
      "const": "https://schemas.cloud-agents.dev/platform/migrations/successor/000014/authority-source.schema.json"
    },
    "formatVersion": { "const": "cloud-agents-platform-migration-successor-source/v1" },
    "authorityId": { "type": "string", "pattern": "^D-[0-9]{3}(?:-[A-Z0-9]+)+$" },
    "revision": { "type": "string", "pattern": "^D-[0-9]{3}(?:-[A-Z0-9]+)+\\.r[0-9]+$" },
    "successorId": { "type": "string", "minLength": 1 },
    "inputScope": { "const": "generator-and-focused-verification-closure/v1" },
    "sourceDescriptor": { "$ref": "#/$defs/artifact" },
    "schemaDescriptor": { "$ref": "#/$defs/artifact" },
    "profileDescriptor": { "$ref": "#/$defs/artifact" },
    "predecessor": { "$ref": "#/$defs/predecessor" },
    "successor": { "$ref": "#/$defs/successor" },
    "inputPaths": { "$ref": "#/$defs/pathSet" },
    "protectedPaths": { "$ref": "#/$defs/pathSet" },
    "exclusionPaths": { "$ref": "#/$defs/pathSet" },
    "archiveAlgorithm": { "$ref": "#/$defs/archiveAlgorithm" },
    "memberAlgorithm": { "$ref": "#/$defs/memberAlgorithm" },
    "receiptPaths": {
      "type": "array",
      "items": { "$ref": "#/$defs/receiptPath" },
      "uniqueItems": true
    },
    "receiptState": { "$ref": "#/$defs/receiptState" },
    "runner": { "$ref": "#/$defs/runner" },
    "toolchain": { "$ref": "#/$defs/toolchain" },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)+$" },
      "uniqueItems": true
    },
    "lineageFence": { "$ref": "#/$defs/lineageFence" },
    "reviewRules": { "$ref": "#/$defs/reviewRules" },
    "implementationBoundary": { "$ref": "#/$defs/implementationBoundary" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?($|/))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode", "sizeBytes", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "mode": { "const": "100644" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestPath",
        "manifestDigest",
        "schemaBundlePath",
        "schemaBundleDigest",
        "schemaHead"
      ],
      "properties": {
        "manifestPath": { "$ref": "#/$defs/path" },
        "manifestDigest": { "$ref": "#/$defs/digest" },
        "schemaBundlePath": { "$ref": "#/$defs/path" },
        "schemaBundleDigest": { "$ref": "#/$defs/digest" },
        "schemaHead": { "$ref": "#/$defs/migrationId" }
      }
    },
    "successor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "migrationId",
        "sqlPath",
        "catalogPath",
        "archivePath",
        "manifestPath",
        "schemaBundlePath"
      ],
      "properties": {
        "migrationId": { "$ref": "#/$defs/migrationId" },
        "sqlPath": { "$ref": "#/$defs/path" },
        "catalogPath": { "$ref": "#/$defs/path" },
        "archivePath": { "$ref": "#/$defs/path" },
        "manifestPath": { "$ref": "#/$defs/path" },
        "schemaBundlePath": { "$ref": "#/$defs/path" }
      }
    },
    "migrationId": { "type": "string", "pattern": "^[0-9]{6}$" },
    "pathSet": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/path" },
      "uniqueItems": true
    },
    "archiveAlgorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "naming", "rewrite"],
      "properties": {
        "kind": { "const": "exact-byte-copy" },
        "naming": { "const": "sha256-logical-schema-bundle-digest" },
        "rewrite": { "const": "forbidden" }
      }
    },
    "memberAlgorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "order", "mode", "uid", "gid", "mtime", "compression", "duplicates"],
      "properties": {
        "kind": { "const": "deterministic-ustar-v1" },
        "order": { "const": "ASCII-byte-path" },
        "mode": { "const": "100644" },
        "uid": { "const": 0 },
        "gid": { "const": 0 },
        "mtime": { "const": 0 },
        "compression": { "const": "none" },
        "duplicates": { "const": "reject" }
      }
    },
    "receiptPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "stage", "state", "writeMode"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/path" },
        "schema": { "$ref": "#/$defs/path" },
        "stage": { "type": "string", "minLength": 1 },
        "state": { "$ref": "#/$defs/receiptStatus" },
        "writeMode": { "enum": ["CREATE_ONCE_APPEND_ONLY", "NO_WRITE"] }
      }
    },
    "receiptStatus": { "enum": ["ABSENT_PENDING", "PRESENT", "FORBIDDEN", "NOT_APPLICABLE"] },
    "receiptState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "appendOnly"],
      "properties": {
        "current": { "type": "string", "minLength": 1 },
        "appendOnly": { "const": true }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrypoint",
        "productionEntrypoint",
        "mode",
        "logicalManifestPath",
        "logicalSchemaBundlePath",
        "completeLedger",
        "entryWriter",
        "recoveryWriter",
        "externalEffects"
      ],
      "properties": {
        "entrypoint": { "$ref": "#/$defs/path" },
        "productionEntrypoint": { "$ref": "#/$defs/path" },
        "mode": { "type": "string", "minLength": 1 },
        "logicalManifestPath": { "$ref": "#/$defs/path" },
        "logicalSchemaBundlePath": { "$ref": "#/$defs/path" },
        "completeLedger": { "const": "no-op" },
        "entryWriter": { "const": "NOT_IMPLEMENTED" },
        "recoveryWriter": { "const": "NOT_IMPLEMENTED" },
        "externalEffects": { "const": "forbidden" }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["go", "node", "bun"],
      "properties": {
        "go": { "type": "string", "minLength": 1 },
        "node": { "type": "string", "minLength": 1 },
        "bun": { "type": "string", "minLength": 1 }
      }
    },
    "lineageFence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "predecessorHead", "successorHead", "reviewRule", "historicalEvidence"],
      "properties": {
        "kind": { "const": "single-predecessor-append-only" },
        "predecessorHead": { "$ref": "#/$defs/migrationId" },
        "successorHead": { "$ref": "#/$defs/migrationId" },
        "reviewRule": { "type": "string", "minLength": 1 },
        "historicalEvidence": { "const": "retain-and-never-rewrite" }
      }
    },
    "reviewRules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independentReadOnly", "verdicts", "candidateMutation", "gateTransition"],
      "properties": {
        "independentReadOnly": { "const": true },
        "verdicts": { "const": ["APPROVE", "REQUEST_CHANGES"] },
        "candidateMutation": { "const": "forbidden" },
        "gateTransition": { "const": "forbidden" }
      }
    },
    "implementationBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "databaseWrites",
        "http",
        "p2",
        "provider",
        "deployment",
        "publication",
        "gateTransition"
      ],
      "properties": {
        "databaseWrites": { "const": "not_authorized" },
        "http": { "const": "forbidden" },
        "p2": { "const": "forbidden" },
        "provider": { "const": "forbidden" },
        "deployment": { "const": "forbidden" },
        "publication": { "const": "forbidden" },
        "gateTransition": { "const": "forbidden" }
      }
    }
  }
}
