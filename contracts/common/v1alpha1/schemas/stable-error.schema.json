{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/common/v1alpha1/schemas/stable-error.schema.json",
  "title": "StableError",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "retryable"],
  "properties": {
    "code": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"
    },
    "retryable": {
      "type": "boolean"
    },
    "retryAfterSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400
    }
  }
}
