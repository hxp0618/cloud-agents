{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/common/v1alpha1/schemas/subject-ref.schema.json",
  "title": "SubjectRef",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "issuer", "subject"],
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["user", "serviceAccount", "workload"]
    },
    "issuer": {
      "type": "string",
      "format": "uri",
      "maxLength": 512
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "x-cloud-agents-canonicalization": {
    "profile": "cloud-agents-subject-ref/v1alpha1",
    "projection": ["kind", "issuer", "subject"],
    "stringComparison": "exact",
    "algorithm": "RFC8785",
    "digest": "SHA-256",
    "digestText": "sha256:<64-lowercase-hex>",
    "numberHandling": "NOT_APPLICABLE_NO_NUMBER_FIELDS"
  }
}
