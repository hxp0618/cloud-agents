{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/identity/v1alpha1/schemas/email-suffix-policy-update.schema.json",
  "title": "EmailSuffixPolicyUpdate",
  "type": "object",
  "additionalProperties": false,
  "required": ["expectedResourceVersion", "allowedDomains"],
  "properties": {
    "expectedResourceVersion": {
      "$ref": "../../../common/v1alpha1/schemas/resource-version.schema.json"
    },
    "allowedDomains": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 253,
        "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$"
      }
    }
  }
}
