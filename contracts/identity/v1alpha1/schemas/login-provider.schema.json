{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/identity/v1alpha1/schemas/login-provider.schema.json",
  "title": "LoginProvider",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "displayName"
  ],
  "properties": {
    "id": {
      "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json"
    },
    "kind": {
      "type": "string",
      "enum": [
        "oidc",
        "github",
        "gitlab",
        "feishu",
        "dingtalk",
        "wecom"
      ]
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    }
  }
}
