{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/identity/v1alpha1/schemas/identity-jwks.schema.json",
  "title": "IdentityJWKS",
  "type": "object",
  "additionalProperties": false,
  "required": ["keys", "cloudAgentsAuthority"],
  "properties": {
    "keys": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/publicJwk" }
    },
    "cloudAgentsAuthority": { "$ref": "#/$defs/authority" }
  },
  "$defs": {
    "decimalRevision": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 19
    },
    "publicJwk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "e", "key_ops", "kid", "kty", "n", "use"],
      "properties": {
        "alg": { "const": "RS256" },
        "e": { "const": "AQAB" },
        "key_ops": {
          "type": "array",
          "prefixItems": [{ "const": "verify" }],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "kid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._~-]{0,126}[A-Za-z0-9])?$",
          "maxLength": 128
        },
        "kty": { "const": "RSA" },
        "n": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 342,
          "maxLength": 683
        },
        "use": { "const": "sig" }
      }
    },
    "lineageKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jwk", "enabled", "notBefore", "notAfter"],
      "properties": {
        "jwk": { "$ref": "#/$defs/publicJwk" },
        "enabled": { "type": "boolean" },
        "notBefore": { "type": "integer", "minimum": 0, "maximum": 253402300799 },
        "notAfter": { "type": "integer", "minimum": 0, "maximum": 253402300799 }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "revision", "securityEpoch", "notBefore", "expiresAt", "lineage"],
      "properties": {
        "issuer": { "type": "string", "format": "uri", "minLength": 1, "maxLength": 512 },
        "revision": { "$ref": "#/$defs/decimalRevision" },
        "securityEpoch": { "$ref": "#/$defs/decimalRevision" },
        "notBefore": { "type": "integer", "minimum": 0, "maximum": 253402300799 },
        "expiresAt": { "type": "integer", "minimum": 0, "maximum": 253402300799 },
        "lineage": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/lineageKey" }
        }
      }
    }
  }
}
