{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/identity/v1alpha1/schemas/service-account-page.schema.json",
  "title": "ServiceAccountPage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "serviceAccounts"
  ],
  "properties": {
    "serviceAccounts": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "service-account.schema.json"
      }
    },
    "nextPageToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  }
}
