{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/identity/v1alpha1/schemas/service-account.schema.json",
  "title": "ServiceAccount",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tenantId",
    "displayName",
    "application",
    "scopeLevel",
    "scopeId",
    "roleName",
    "state",
    "resourceVersion",
    "subject",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json"
    },
    "tenantId": {
      "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "application": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ]
    },
    "scopeLevel": {
      "type": "string",
      "enum": [
        "tenant",
        "organization",
        "project"
      ]
    },
    "scopeId": {
      "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json"
    },
    "roleName": {
      "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json"
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "disabled"
      ]
    },
    "resourceVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "subject": {
      "$ref": "../../../common/v1alpha1/schemas/subject-ref.schema.json"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
