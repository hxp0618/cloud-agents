{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/identity/v1alpha1/schemas/service-account-create-request.schema.json",
  "title": "ServiceAccountCreateRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "serviceAccountId",
    "displayName",
    "application",
    "roleName",
    "scopeLevel",
    "scopeId"
  ],
  "properties": {
    "serviceAccountId": {
      "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "application": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ]
    },
    "roleName": {
      "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json"
    },
    "scopeLevel": {
      "type": "string",
      "enum": [
        "tenant",
        "organization",
        "project"
      ]
    },
    "scopeId": {
      "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json"
    }
  }
}
