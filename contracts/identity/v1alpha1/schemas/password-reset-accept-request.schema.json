{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/identity/v1alpha1/schemas/password-reset-accept-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["resetCode", "newPassword"],
  "properties": {
    "resetCode": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "newPassword": { "type": "string", "minLength": 15, "maxLength": 128 }
  }
}
