{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/identity/v1alpha1/schemas/cli-authorization-approved.schema.json",
  "title": "CliAuthorizationApproved",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "callbackPort",
    "state",
    "authorizationCode",
    "expiresAt"
  ],
  "properties": {
    "callbackPort": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "state": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "authorizationCode": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
