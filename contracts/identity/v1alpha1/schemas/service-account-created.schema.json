{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/identity/v1alpha1/schemas/service-account-created.schema.json",
  "title": "ServiceAccountCreated",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "serviceAccount",
    "credential",
    "credentialExpiresAt"
  ],
  "properties": {
    "serviceAccount": {
      "$ref": "service-account.schema.json"
    },
    "credential": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "credentialExpiresAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
