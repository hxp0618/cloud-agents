{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/identity/v1alpha1/schemas/invitation-accept-request.schema.json",
  "title": "InvitationAcceptRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["invitationCode"],
  "properties": {
    "invitationCode": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "password": {
      "type": "string",
      "minLength": 15,
      "maxLength": 128
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    }
  }
}
