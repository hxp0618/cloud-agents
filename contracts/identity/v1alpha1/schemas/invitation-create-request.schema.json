{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/identity/v1alpha1/schemas/invitation-create-request.schema.json",
  "title": "InvitationCreateRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["email", "roleName", "scopeLevel", "scopeId", "verification"],
  "properties": {
    "email": {
      "type": "string",
      "minLength": 3,
      "maxLength": 254,
      "pattern": "^[^\\s@]+@[^\\s@]+$"
    },
    "roleName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "scopeLevel": {
      "type": "string",
      "enum": ["tenant", "organization", "project"]
    },
    "scopeId": {
      "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json"
    },
    "verification": {
      "type": "string",
      "enum": ["admin-attested", "provider-required"]
    }
  }
}
