{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/identity/v1alpha1/schemas/password-reset-created.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["userId", "resetCode", "expiresAt"],
  "properties": {
    "userId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "resetCode": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "expiresAt": { "type": "string", "format": "date-time" }
  }
}
