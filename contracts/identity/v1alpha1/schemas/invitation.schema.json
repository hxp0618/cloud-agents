{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/identity/v1alpha1/schemas/invitation.schema.json",
  "title": "Invitation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tenantId",
    "email",
    "roleName",
    "scopeLevel",
    "scopeId",
    "verification",
    "state",
    "createdAt",
    "expiresAt"
  ],
  "properties": {
    "id": {
      "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json"
    },
    "tenantId": {
      "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json"
    },
    "email": {
      "type": "string",
      "minLength": 3,
      "maxLength": 254,
      "pattern": "^[^\\s@]+@[^\\s@]+$"
    },
    "roleName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "scopeLevel": {
      "type": "string",
      "enum": ["tenant", "organization", "project"]
    },
    "scopeId": {
      "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json"
    },
    "verification": {
      "type": "string",
      "enum": ["admin-attested", "provider-required"]
    },
    "state": {
      "type": "string",
      "enum": ["pending", "accepted", "revoked", "expired"]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
