{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/identity/v1alpha1/schemas/cli-authorization-start-request.schema.json",
  "title": "CliAuthorizationStartRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "application",
    "callbackPort",
    "state",
    "codeChallenge"
  ],
  "properties": {
    "application": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ]
    },
    "callbackPort": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "state": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "codeChallenge": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    }
  }
}
