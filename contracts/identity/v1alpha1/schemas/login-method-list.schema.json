{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/identity/v1alpha1/schemas/login-method-list.schema.json",
  "title": "LoginMethodList",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "passwordEnabled",
    "loginMethods"
  ],
  "properties": {
    "passwordEnabled": {
      "type": "boolean"
    },
    "loginMethods": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "login-method.schema.json"
      }
    }
  }
}
