{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/identity/v1alpha1/schemas/tenant-token-authorization.schema.json",
  "title": "TenantTokenAuthorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["userId", "issuer", "tenantId", "application", "scopes"],
  "properties": {
    "userId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "issuer": {
      "type": "string",
      "format": "uri",
      "minLength": 1,
      "maxLength": 512
    },
    "tenantId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "projectId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "application": {
      "type": "string",
      "enum": ["admin", "user"]
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9-]*\\.(?:create|get|list|watch|update|delete|act|bind)$"
      }
    }
  },
  "description": "Control Plane authorization result derived from live session, account, membership, and role-binding state. Scopes are unique and strictly sorted."
}
