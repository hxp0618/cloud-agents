{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/identity/v1alpha1/schemas/service-account-rotated.schema.json",
  "title": "ServiceAccountRotated",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resourceVersion",
    "credentialVersion",
    "credential",
    "credentialExpiresAt"
  ],
  "properties": {
    "resourceVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "credentialVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "credential": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "credentialExpiresAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
