{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/managed-agent/v1alpha1/schemas/capability-event.schema.json",
  "title": "CapabilityEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "managed-agent.cloud-agents.dev/v1alpha1" },
    "kind": { "const": "CapabilityEvent" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid", "projectId", "sessionId", "sequence", "occurredAt"],
      "properties": {
        "uid": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
        "projectId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
        "sessionId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
        "sequence": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)$", "maxLength": 20 },
        "occurredAt": { "type": "string", "format": "date-time" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "resource", "generation", "result"],
      "properties": {
        "operation": { "enum": ["mcp.call", "mcp.fail", "mcp.revoke", "skill.load", "skill.fail", "skill.revoke"] },
        "resource": { "enum": ["McpServer", "SkillBundle"] },
        "generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "result": { "enum": ["accepted", "succeeded", "failed", "revoked"] },
        "serverId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
        "bundleId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
        "version": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "errorCode": { "type": "string", "pattern": "^[a-z0-9_-]{1,64}$" },
        "inputDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "resultDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "oneOf": [
        { "required": ["serverId", "version", "digest"], "not": { "required": ["bundleId"] } },
        { "required": ["bundleId", "version", "digest"], "not": { "required": ["serverId"] } }
      ]
    }
  },
  "x-cloud-agents-semantic-constraints": [
    "events carry opaque IDs, versions, digests and error codes only; MCP payloads, Skill source and credentials are excluded",
    "failed or revoked capability events are terminal facts and are never replayed as external side effects"
  ]
}
