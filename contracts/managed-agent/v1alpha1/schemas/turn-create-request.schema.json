{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/managed-agent/v1alpha1/schemas/turn-create-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["turnId", "inputText"],
  "properties": {
    "turnId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._~-]{0,126}[A-Za-z0-9])?$"
    },
    "inputText": {
      "type": "string",
      "maxLength": 1048576
    }
  }
}
