{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/managed-agent/v1alpha1/schemas/session.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "managed-agent.cloud-agents.dev/v1alpha1" },
    "kind": { "const": "Session" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid", "projectId", "resourceVersion", "createdAt", "updatedAt"],
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "resourceVersion": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerKind", "state"],
      "properties": {
        "providerKind": { "type": "string", "minLength": 1, "maxLength": 64 },
        "state": { "enum": ["active", "closed"] }
      }
    }
  }
}
