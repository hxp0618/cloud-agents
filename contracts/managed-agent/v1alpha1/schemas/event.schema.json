{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/managed-agent/v1alpha1/schemas/event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "managed-agent.cloud-agents.dev/v1alpha1" },
    "kind": { "const": "Event" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid", "projectId", "sessionId", "sequence", "occurredAt"],
      "properties": {
        "uid": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
        "projectId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
        "sessionId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
        "sequence": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)$", "maxLength": 20 },
        "occurredAt": { "type": "string", "format": "date-time" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "resource", "generation", "mutationDigest", "changes"],
      "properties": {
        "operation": { "type": "string", "enum": ["session.create", "session.close", "turn.create", "execution.create", "execution.start", "execution.complete", "execution.fail", "turn.interrupt", "turn.cancel"] },
        "resource": { "type": "string", "enum": ["Session", "Turn", "Execution"] },
        "generation": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "mutationDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "inputDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "resultDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "errorCode": { "type": "string", "pattern": "^[a-z0-9_-]{1,64}$" },
        "turnId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
        "executionId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
        "changes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["resource", "from", "to", "version"],
            "properties": {
              "resource": { "type": "string", "enum": ["Session", "Turn", "Execution"] },
              "from": { "type": "string", "maxLength": 32 },
              "to": { "type": "string", "maxLength": 32 },
              "version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
            }
          }
        }
      }
    }
  }
}
