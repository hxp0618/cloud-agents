{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/managed-agent/v1alpha1/schemas/execution-create-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["turnId", "executionId", "inputText"],
  "properties": {
    "turnId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "executionId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "model": { "type": "string", "minLength": 1, "maxLength": 128 },
    "runtimeMode": { "enum": ["approval-required", "full-access"] },
    "interactionMode": { "enum": ["default", "plan"] },
    "inputText": { "type": "string", "minLength": 1, "maxLength": 1048576 },
    "mcpServerRefs": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["serverId", "version", "digest"],
        "properties": {
          "serverId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
          "version": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "skillBundleRefs": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bundleId", "version", "digest"],
        "properties": {
          "bundleId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
          "version": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    }
  }
}
