{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/managed-agent/v1alpha1/schemas/turn.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "managed-agent.cloud-agents.dev/v1alpha1" },
    "kind": { "const": "Turn" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid", "projectId", "sessionId", "resourceVersion", "createdAt", "updatedAt"],
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "resourceVersion": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputDigest", "state"],
      "properties": {
        "inputDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "executionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "state": { "enum": ["queued", "running", "completed", "failed", "interrupted", "cancelled"] }
      }
    }
  }
}
