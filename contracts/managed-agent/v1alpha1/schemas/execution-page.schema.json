{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/managed-agent/v1alpha1/schemas/execution-page.schema.json",
  "title": "ExecutionPage",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "executions"],
  "properties": {
    "apiVersion": { "const": "managed-agent.cloud-agents.dev/v1alpha1" },
    "kind": { "const": "ExecutionPage" },
    "executions": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "execution.schema.json" }
    },
    "nextPageToken": {
      "$ref": "../../../common/v1alpha1/schemas/page-token.schema.json"
    }
  }
}
