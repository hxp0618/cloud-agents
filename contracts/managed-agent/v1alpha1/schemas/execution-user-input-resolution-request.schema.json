{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/managed-agent/v1alpha1/schemas/execution-user-input-resolution-request.schema.json",
  "title": "ManagedAgentUserInputResolutionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["generation", "requestId", "answers"],
  "properties": {
    "generation": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" },
    "answers": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 3,
      "additionalProperties": false,
      "patternProperties": {
        "^[^\\u0000-\\u001F\\u007F]{1,200}$": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^[^\\u0000]+$" }
        }
      }
    }
  }
}
