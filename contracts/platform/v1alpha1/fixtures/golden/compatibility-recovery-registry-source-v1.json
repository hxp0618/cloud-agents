{
  "formatVersion": "cloud-agents-compatibility-recovery-source/v1",
  "registryId": "cloud-agents/platform/compatibility-recovery",
  "schemaRange": {
    "minInclusive": "000001",
    "maxInclusive": "000009",
    "comparison": "zero-padded-migration-id-inclusive"
  },
  "profiles": [
    {
      "profileId": "backfill/v1",
      "kind": "backfill",
      "stateMachineId": "backfill/v1",
      "persistedFields": ["committed_at", "count", "cursor", "digest", "migration_id", "phase"],
      "requiredEvidence": ["count", "cursor", "digest", "phase"],
      "rules": [
        "each_batch_short_transaction",
        "resume_from_last_durable_cursor",
        "unknown_outcome_requires_reconciliation"
      ]
    },
    {
      "profileId": "live-instance/v1",
      "kind": "live_instance",
      "stateMachineId": "live-instance/v1",
      "persistedFields": [
        "binary_version",
        "drain_state",
        "heartbeat_at",
        "heartbeat_ttl_seconds",
        "incarnation",
        "instance_id",
        "rollout_generation",
        "service_kind",
        "supported_schema_max",
        "supported_schema_min",
        "writer_epoch"
      ],
      "requiredEvidence": [
        "binary_version",
        "drain_state",
        "heartbeat_at",
        "heartbeat_ttl_seconds",
        "incarnation",
        "instance_id",
        "rollout_generation",
        "service_kind",
        "supported_schema_max",
        "supported_schema_min",
        "writer_epoch"
      ],
      "rules": [
        "drain_state_is_not_inferred_from_process_exit",
        "rollout_generation_is_monotonic",
        "stale_but_not_expired_reject",
        "supported_schema_range_is_inclusive",
        "writer_epoch_is_monotonic"
      ]
    },
    {
      "profileId": "migration-preflight/v1",
      "kind": "migration_preflight",
      "stateMachineId": "migration-preflight/v1",
      "persistedFields": [
        "decision",
        "ledger_checksum",
        "postgres_major",
        "restore_evidence_digest",
        "rollout_generation",
        "target_phase",
        "target_schema_bundle_digest",
        "writer_epoch"
      ],
      "requiredEvidence": [
        "ledger_checksum",
        "postgres_major",
        "restore_evidence_digest",
        "rollout_generation",
        "target_phase",
        "target_schema_bundle_digest",
        "writer_epoch"
      ],
      "rules": [
        "all_unexpired_instances_must_read_target",
        "irreversible_contract_requires_separate_approval",
        "registry_unavailable_reject",
        "rollback_target_must_read_target"
      ]
    },
    {
      "profileId": "restore-evidence/v1",
      "kind": "restore_evidence",
      "stateMachineId": "restore-evidence/v1",
      "persistedFields": [
        "drill_at",
        "drill_id",
        "ledger_checksum",
        "postgres_major",
        "restore_point_digest",
        "scope",
        "target_phase",
        "target_schema_bundle_digest"
      ],
      "requiredEvidence": [
        "drill_at",
        "drill_id",
        "ledger_checksum",
        "postgres_major",
        "restore_point_digest",
        "target_phase",
        "target_schema_bundle_digest"
      ],
      "rules": [
        "local_logical_backup_restore_only",
        "pitr_ha_reserved_for_p4",
        "target_bundle_phase_and_restore_point_exact_match"
      ]
    },
    {
      "profileId": "retirement-receipt/v1",
      "kind": "retirement_receipt",
      "stateMachineId": "retirement-receipt/v1",
      "persistedFields": [
        "claim_released",
        "credential_revoked",
        "endpoint_revoked",
        "generation_fenced",
        "incarnation",
        "instance_id",
        "leader_released",
        "process_terminated",
        "rollout_generation"
      ],
      "requiredEvidence": [
        "claim_released",
        "credential_revoked",
        "endpoint_revoked",
        "generation_fenced",
        "leader_released",
        "process_terminated"
      ],
      "rules": [
        "all_required_facts_are_durable",
        "contradiction_rejects_receipt",
        "expired_registration_excluded_only_with_same_identity_receipt"
      ]
    }
  ],
  "stateMachines": [
    {
      "id": "backfill/v1",
      "initialState": "pending",
      "states": ["failed", "paused", "pending", "running", "succeeded"],
      "terminalStates": ["failed", "succeeded"],
      "transitions": [
        { "from": "paused", "event": "resume", "to": "running" },
        { "from": "pending", "event": "begin", "to": "running" },
        { "from": "running", "event": "batch_committed", "to": "running" },
        { "from": "running", "event": "complete", "to": "succeeded" },
        { "from": "running", "event": "fail", "to": "failed" },
        { "from": "running", "event": "pause", "to": "paused" }
      ]
    },
    {
      "id": "live-instance/v1",
      "initialState": "registered",
      "states": ["active", "drained", "draining", "expired_unproven", "registered", "retired"],
      "terminalStates": ["retired"],
      "transitions": [
        { "from": "active", "event": "begin_drain", "to": "draining" },
        { "from": "active", "event": "heartbeat", "to": "active" },
        { "from": "active", "event": "ttl_expired", "to": "expired_unproven" },
        { "from": "drained", "event": "retire_with_receipt", "to": "retired" },
        { "from": "draining", "event": "finish_drain", "to": "drained" },
        { "from": "draining", "event": "heartbeat", "to": "draining" },
        { "from": "expired_unproven", "event": "retire_with_receipt", "to": "retired" },
        { "from": "registered", "event": "activate", "to": "active" },
        { "from": "registered", "event": "ttl_expired", "to": "expired_unproven" }
      ]
    },
    {
      "id": "migration-preflight/v1",
      "initialState": "unverified",
      "states": ["approved", "rejected", "unverified"],
      "terminalStates": ["approved", "rejected"],
      "transitions": [
        { "from": "unverified", "event": "approve_exact_preflight", "to": "approved" },
        { "from": "unverified", "event": "reject_unproven_or_contradictory", "to": "rejected" }
      ]
    },
    {
      "id": "restore-evidence/v1",
      "initialState": "recorded",
      "states": ["drill_verified", "eligible", "invalidated", "recorded"],
      "terminalStates": ["eligible", "invalidated"],
      "transitions": [
        { "from": "drill_verified", "event": "invalidate", "to": "invalidated" },
        { "from": "drill_verified", "event": "prove_eligibility", "to": "eligible" },
        { "from": "recorded", "event": "drill_failed", "to": "invalidated" },
        { "from": "recorded", "event": "drill_succeeded", "to": "drill_verified" }
      ]
    },
    {
      "id": "retirement-receipt/v1",
      "initialState": "collecting",
      "states": ["collecting", "complete", "rejected"],
      "terminalStates": ["complete", "rejected"],
      "transitions": [
        { "from": "collecting", "event": "all_required_facts", "to": "complete" },
        { "from": "collecting", "event": "contradiction", "to": "rejected" }
      ]
    }
  ],
  "policies": {
    "bootstrap": {
      "emptyRegistry": "new_database_explicit_bootstrap_only",
      "existingLedger": "bootstrap_exception_forbidden",
      "unavailableRegistry": "reject"
    },
    "preflight": {
      "requiredEvidence": [
        "ledger_checksum",
        "live_instances",
        "postgres_major",
        "restore_evidence",
        "rollback_target",
        "target_bundle_and_phase"
      ],
      "writerRule": "current_writer_must_read_and_write_target_schema",
      "oldWriterRule": "unknown_or_disjoint_or_stale_or_undrained_reject",
      "approvalRule": "irreversible_contract_requires_separate_approval_and_matching_restore_drill"
    },
    "expiredRegistration": {
      "identityFields": ["incarnation", "instance_id", "rollout_generation"],
      "requiredReceiptFacts": [
        "claim_released",
        "credential_revoked",
        "endpoint_revoked",
        "generation_fenced",
        "leader_released",
        "process_terminated"
      ],
      "exclusionRule": "same_instance_incarnation_generation_receipt_only"
    },
    "restore": {
      "scope": "local_logical_backup_restore_and_preflight",
      "pitrHa": "p4_not_implemented",
      "evidenceRule": "target_bundle_phase_restore_point_and_drill_must_match"
    },
    "failureMode": "fail_closed"
  },
  "implementationBoundary": {
    "sqlMigration": "not_implemented_no_000010",
    "goConsumer": "not_implemented",
    "httpSurface": "not_implemented",
    "externalSideEffects": "forbidden",
    "gateStatus": "non_gate_evidence_only"
  }
}
