      "expectedError": "ROLE_SCOPE_MISMATCH"
    },
    {
      "name": "role-binding-unknown-role",
      "schema": "../schemas/role-binding.schema.json",
      "instance": "negative/role-binding-unknown-role.json",
      "expectedSchemaValid": false,
      "expectedSemanticValid": false,
      "expectedError": "UNKNOWN_ROLE"
    },
    {
      "name": "role-wildcard-permission",
      "schema": "../schemas/role.schema.json",
      "instance": "negative/role-wildcard-permission.json",
      "expectedSchemaValid": false,
      "expectedSemanticValid": false,
      "expectedError": "WILDCARD_PERMISSION_FORBIDDEN"
