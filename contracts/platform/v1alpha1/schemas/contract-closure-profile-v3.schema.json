{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/platform/v1alpha1/schemas/contract-closure-profile-v3.schema.json",
  "title": "ContractClosureProfileV3",
  "description": "Generated digest-bound non-Gate G-CONTRACT closure profile registry v3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "registryId",
    "sourceDigest",
    "predecessor",
    "runtimeReviewedCandidate",
    "generatorSupplyV1Predecessor",
    "profile",
    "missing",
    "notGateClosure",
    "gateStatus",
    "registryDigest"
  ],
  "properties": {
    "formatVersion": { "const": "cloud-agents-contract-closure-profile-registry/v3" },
    "registryId": { "const": "cloud-agents/platform/contract-closure-profile" },
    "sourceDigest": { "$ref": "#/$defs/digest" },
    "predecessor": {
      "$ref": "contract-closure-profile-source-v3.schema.json#/$defs/predecessor"
    },
    "runtimeReviewedCandidate": {
      "$ref": "contract-closure-profile-source-v3.schema.json#/$defs/runtimeReviewedCandidate"
    },
    "generatorSupplyV1Predecessor": {
      "$ref": "contract-closure-profile-source-v3.schema.json#/$defs/generatorSupplyV1Predecessor"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileDigest", "spec"],
      "properties": {
        "profileDigest": { "$ref": "#/$defs/digest" },
        "spec": { "$ref": "contract-closure-profile-source-v3.schema.json#/$defs/profile" }
      }
    },
    "missing": { "const": ["remaining-generator-supply-chain-review"] },
    "notGateClosure": { "const": true },
    "gateStatus": { "const": "ALL_GATES_OPEN" },
    "registryDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "x-cloud-agents-security": {
    "editable": false,
    "status": "BOOTSTRAP_VALIDATED",
    "notGateClosure": true,
    "gateStatus": "ALL_GATES_OPEN",
    "effectiveMissingRemoval": "detached_review_binding_only"
  }
}
