{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/platform/v1alpha1/schemas/worker-release-register-request.schema.json",
  "title": "WorkerReleaseRegisterRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["releaseId", "releaseName", "imageRepository", "releaseDigest", "platformVersion", "runtimeVersion", "codexVersion", "claudeCodeVersion", "architectures", "verificationEvidenceDigest"],
  "properties": {
    "releaseId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "releaseName": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "imageRepository": { "type": "string", "minLength": 3, "maxLength": 512, "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*(?::[0-9]{1,5})?(?:/[a-z0-9]+(?:[._-][a-z0-9]+)*)+$" },
    "releaseDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "platformVersion": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "runtimeVersion": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "codexVersion": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "claudeCodeVersion": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "architectures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["linux/amd64", "linux/arm64"] }
    },
    "verificationEvidenceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "x-cloud-agents-semantic-constraints": [
    "registration is the privileged approval action and records only immutable image and version metadata",
    "imageRepository excludes a tag or digest and releaseDigest is the exact OCI manifest digest",
    "verificationEvidenceDigest identifies external release verification evidence without exposing its contents"
  ]
}
