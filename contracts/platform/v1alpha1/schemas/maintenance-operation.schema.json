{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/platform/v1alpha1/schemas/maintenance-operation.schema.json",
  "title": "MaintenanceOperation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "operationId",
    "idempotencyKey",
    "action",
    "resourceKind",
    "resourceId",
    "resourceGeneration",
    "requestedBy",
    "requestId",
    "requestedAt",
    "updatedAt",
    "state",
    "currentStep",
    "impactSummary",
    "retryable"
  ],
  "properties": {
    "apiVersion": { "const": "platform.cloud-agents.dev/v1alpha1" },
    "kind": { "const": "MaintenanceOperation" },
    "operationId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "idempotencyKey": { "$ref": "../../../common/v1alpha1/schemas/idempotency-key.schema.json" },
    "action": { "enum": ["target.register", "target.probe", "target.drain", "target.resume", "target.cleanup"] },
    "resourceKind": { "const": "DeploymentTarget" },
    "resourceId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "resourceGeneration": { "type": "integer", "minimum": 1 },
    "requestedBy": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "requestId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "requestedAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "state": { "enum": ["queued", "running", "succeeded", "failed", "cancelled"] },
    "currentStep": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "stableErrorCode": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "impactSummary": { "type": "string", "minLength": 1, "maxLength": 256 },
    "retryable": { "type": "boolean" }
  }
}
