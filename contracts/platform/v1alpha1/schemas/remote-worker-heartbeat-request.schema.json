{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/platform/v1alpha1/schemas/remote-worker-heartbeat-request.schema.json",
  "title": "RemoteWorkerHeartbeatRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incarnationId",
    "observedGeneration",
    "observedState",
    "workerVersion",
    "os",
    "architecture",
    "kernelVersion",
    "capabilities",
    "capacity"
  ],
  "properties": {
    "incarnationId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "observedGeneration": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "observedState": { "enum": ["active", "drained"] },
    "workerVersion": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$" },
    "os": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "architecture": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "kernelVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\u0020-\\u007E]+$"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "enum": ["docker", "exec", "files", "pty", "preview", "ssh"] }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpuMillis", "memoryBytes", "diskBytes"],
      "properties": {
        "cpuMillis": { "type": "integer", "minimum": 100, "maximum": 512000000 },
        "memoryBytes": { "type": "integer", "minimum": 134217728, "maximum": 8796093022208000 },
        "diskBytes": { "type": "integer", "minimum": 134217728, "maximum": 8796093022208000 }
      }
    },
    "commandReceipt": { "$ref": "./remote-worker-command-receipt.schema.json" },
    "sandboxCommandReceipt": { "$ref": "./remote-worker-sandbox-command-receipt.schema.json" },
    "sandboxExecCommandReceipt": { "$ref": "./remote-worker-sandbox-exec-command-receipt.schema.json" },
    "sandboxFileCommandReceipt": { "$ref": "./remote-worker-sandbox-file-command-receipt.schema.json" },
    "sandboxPtyCommandReceipt": { "$ref": "./remote-worker-sandbox-pty-command-receipt.schema.json" },
    "sandboxPreviewCommandReceipt": { "$ref": "./remote-worker-sandbox-preview-command-receipt.schema.json" }
  },
  "x-cloud-agents-semantic-constraints": [
    "the mTLS SPIFFE identity supplies tenant, project, enrollment, and incarnation authority",
    "the server, not the node, owns desired generation and scheduling state",
    "command receipts are retried until one heartbeat response acknowledges them"
  ]
}
