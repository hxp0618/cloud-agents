{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/platform/v1alpha1/schemas/admin-sandbox-session.schema.json",
  "title": "AdminSandboxSession",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "platform.cloud-agents.dev/v1alpha1" },
    "kind": { "const": "AdminSandboxSession" },
    "metadata": { "$ref": "../../../common/v1alpha1/schemas/resource-metadata.schema.json" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectRef",
        "operationId",
        "operationState",
        "cleanupPhase",
        "workspaceId",
        "workspaceName",
        "volumeId",
        "workspaceRetention",
        "workspaceObservedState",
        "runtimeProfileId",
        "runtimeProfileVersion",
        "workloadTrust",
        "isolationRuntime",
        "targetId",
        "generation",
        "observedGeneration",
        "desiredState",
        "observedState",
        "writerReleased",
        "networkPolicyEnforcement"
      ],
      "properties": {
        "projectRef": { "$ref": "../../../common/v1alpha1/schemas/project-ref.schema.json" },
        "operationId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
        "operationState": { "enum": ["pending", "running", "reconciling", "succeeded", "failed"] },
        "cleanupPhase": { "enum": ["none", "complete", "blocked"] },
        "workspaceId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
        "workspaceName": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
        "volumeId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
        "physicalVolumeId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
        "workspaceRetention": { "const": "retained" },
        "workspaceObservedState": { "enum": ["pending", "available", "unknown", "failed"] },
        "runtimeProfileId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
        "runtimeProfileVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "workloadTrust": {
          "enum": ["trusted-single-tenant", "dedicated-node", "shared-untrusted"]
        },
        "isolationRuntime": { "enum": ["runc", "gvisor"] },
        "targetId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
        "networkPolicyRef": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
        "networkPolicyEnforcement": {
          "enum": ["legacy", "pending", "enforced", "failed", "stopped"]
        },
        "generation": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "observedGeneration": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "desiredState": { "enum": ["running", "stopped"] },
        "observedState": { "enum": ["pending", "running", "unknown", "failed", "stopped"] },
        "writerReleased": { "type": "boolean" },
        "ttlSeconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
        "expiresAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "lifecycleTrigger": { "enum": ["manual", "ttl"] },
        "runtimeId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
        "runtimeState": {
          "enum": [
            "Pending",
            "Running",
            "Pausing",
            "Paused",
            "Resuming",
            "Stopping",
            "Terminated",
            "Failed"
          ]
        },
        "stableErrorCode": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
        "observedAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "latestRuntimeGeneration",
            "allocatedMilliseconds",
            "cpuMillisMilliseconds",
            "memoryByteMilliseconds",
            "checkpointedAt"
          ],
          "properties": {
            "latestRuntimeGeneration": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "allocatedMilliseconds": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,39})$" },
            "cpuMillisMilliseconds": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,39})$" },
            "memoryByteMilliseconds": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,39})$" },
            "checkpointedAt": { "type": "string", "format": "date-time", "maxLength": 64 },
            "finalizedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
          }
        },
        "workspaceVolumeUsage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "measurementGeneration", "state"],
          "properties": {
            "source": { "const": "docker-system-df-v1" },
            "measurementGeneration": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "state": { "enum": ["pending", "measuring", "ready", "failed"] },
            "usedBytes": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,18})$" },
            "checkpointedAt": { "type": "string", "format": "date-time", "maxLength": 64 },
            "observedAt": { "type": "string", "format": "date-time", "maxLength": 64 },
            "stableErrorCode": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" }
          }
        },
        "networkUsage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "latestRuntimeGeneration",
            "measurementGeneration",
            "state",
            "observedAt"
          ],
          "properties": {
            "source": { "const": "docker-container-stats-v1" },
            "latestRuntimeGeneration": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "measurementGeneration": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "state": { "enum": ["measuring", "ready", "failed"] },
            "receivedBytes": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,18})$" },
            "transmittedBytes": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,18})$" },
            "checkpointedAt": { "type": "string", "format": "date-time", "maxLength": 64 },
            "observedAt": { "type": "string", "format": "date-time", "maxLength": 64 },
            "stableErrorCode": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" }
          }
        },
        "usageCorrections": {
          "description": "Complete append-only correction audit for this Sandbox. P0 rejects a 101st record rather than truncating this array.",
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "correctionId",
              "metric",
              "adjustment",
              "reasonCode",
              "sandboxGeneration",
              "priorResourceVersion",
              "requestedBy",
              "requestId",
              "createdAt"
            ],
            "properties": {
              "correctionId": {
                "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json"
              },
              "metric": {
                "enum": [
                  "allocatedMilliseconds",
                  "cpuMillisMilliseconds",
                  "memoryByteMilliseconds",
                  "workspaceUsedBytes",
                  "networkReceivedBytes",
                  "networkTransmittedBytes"
                ]
              },
              "adjustment": { "type": "string", "pattern": "^-?[1-9][0-9]{0,39}$" },
              "reasonCode": {
                "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json"
              },
              "sandboxGeneration": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              },
              "priorResourceVersion": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,18}$"
              },
              "requestedBy": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "requestId": {
                "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json"
              },
              "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 }
            }
          }
        }
      }
    }
  },
  "x-cloud-agents-semantic-constraints": [
    "Admin projection contains lifecycle metadata only and never endpoint, credential, prompt, file or artifact content",
    "physicalVolumeId is opaque and workspaceRetention is always retained in BASE-M1",
    "ttlSeconds and expiresAt are absent only for resources accepted before TTL authority existed",
    "lifecycleTrigger identifies durable manual or TTL acceptance without exposing user content",
    "networkPolicyEnforcement is derived from the verified lifecycle result; legacy identifies pre-authority profiles",
    "usage contains database-clock allocation facts only; decimal strings preserve values beyond JavaScript safe integers",
    "usage is absent only until the first database checkpoint; finalizedAt is absent while any runtime segment remains active",
    "workspaceVolumeUsage is absent until the Controller discovers a supported backend and contains backend metadata only, never Workspace file names or content",
    "workspaceVolumeUsage.usedBytes is Docker backend occupied bytes reported by GET /system/df and is not an enforced capacity or billable amount",
    "workspaceVolumeUsage pending has generation zero and no observation; ready requires usedBytes and checkpointedAt; failed requires stableErrorCode and may retain the last good usedBytes and checkpointedAt",
    "networkUsage is the latest direct-Docker runtime generation cumulative container RX/TX byte checkpoint and never includes packet, address, destination or payload data",
    "networkUsage is absent for unsupported backends or before the first measurement; failed observations may retain the last good byte counters and checkpoint",
    "usageCorrections are immutable signed deltas over persisted raw facts and never replace those facts",
    "usageCorrections contain only Admin metadata and never user content, credentials, endpoints or prices"
  ]
}
