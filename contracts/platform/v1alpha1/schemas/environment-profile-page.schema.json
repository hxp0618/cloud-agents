{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/platform/v1alpha1/schemas/environment-profile-page.schema.json",
  "title": "EnvironmentProfilePage",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "environmentProfiles"],
  "properties": {
    "apiVersion": { "const": "platform.cloud-agents.dev/v1alpha1" },
    "kind": { "const": "EnvironmentProfilePage" },
    "environmentProfiles": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "environment-profile.schema.json" }
    },
    "nextPageToken": { "$ref": "../../../common/v1alpha1/schemas/page-token.schema.json" }
  }
}
