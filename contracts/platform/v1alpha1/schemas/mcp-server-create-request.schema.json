{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/platform/v1alpha1/schemas/mcp-server-create-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["serverId", "version", "digest", "transport", "connectionRef", "credentialRef", "networkPolicyRef", "permissions"],
  "properties": {
    "serverId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "version": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "transport": { "enum": ["stdio", "sse", "streamable-http"] },
    "connectionRef": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "credentialRef": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "networkPolicyRef": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,127}$" }
    }
  }
}
