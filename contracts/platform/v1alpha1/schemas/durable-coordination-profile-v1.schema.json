{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/platform/v1alpha1/schemas/durable-coordination-profile-v1.schema.json",
  "title": "DurableCoordinationProfileV1",
  "description": "Editable source profile for one contract-registered idempotent operation. Runtime consumers use only the generated registry entry and profile digest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "profileId",
    "operationId",
    "http",
    "subjectIdentity",
    "projection",
    "authorization",
    "coordination",
    "idempotency",
    "result"
  ],
  "properties": {
    "formatVersion": {
      "const": "cloud-agents-durable-coordination-profile/v1"
    },
    "profileId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][A-Za-z0-9]*(?:[./-][A-Za-z0-9]+)*$"
    },
    "operationId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][A-Za-z0-9]*$"
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path", "idempotencyHeader"],
      "properties": {
        "method": { "enum": ["DELETE", "PATCH", "POST", "PUT"] },
        "path": {
          "type": "string",
          "minLength": 2,
          "maxLength": 512,
          "pattern": "^/v[1-9][A-Za-z0-9{}._/-]*$"
        },
        "idempotencyHeader": { "const": "Idempotency-Key" }
      }
    },
    "subjectIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaId", "digestProfile", "comparison"],
      "properties": {
        "schemaId": {
          "const": "https://schemas.cloud-agents.dev/common/v1alpha1/schemas/subject-ref.schema.json"
        },
        "digestProfile": { "const": "cloud-agents-subject-ref/v1alpha1-rfc8785-sha256" },
        "comparison": { "const": "exact_string_no_rewrite" }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaId",
        "canonicalizationProfile",
        "canonicalizationAlgorithm",
        "digestAlgorithm",
        "numberHandling"
      ],
      "properties": {
        "schemaId": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://schemas[.]cloud-agents[.]dev/platform/v1alpha1/schemas/[a-z0-9-]+[.]schema[.]json$"
        },
        "canonicalizationProfile": {
          "type": "string",
          "minLength": 8,
          "maxLength": 192,
          "pattern": "^cloud-agents-http-idempotency/[a-z][A-Za-z0-9]*/v1alpha1$"
        },
        "canonicalizationAlgorithm": { "const": "RFC8785" },
        "digestAlgorithm": { "const": "SHA-256" },
        "numberHandling": { "const": "NOT_APPLICABLE_NO_NUMBER_FIELDS" }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantSource", "scopeSource", "requiredPermission"],
      "properties": {
        "tenantSource": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^(?:path|body)(?:[.][A-Za-z][A-Za-z0-9]*)+$"
        },
        "scopeSource": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^(?:path|body)(?:[.][A-Za-z][A-Za-z0-9]*)+$"
        },
        "requiredPermission": {
          "$ref": "permission.schema.json"
        }
      }
    },
    "coordination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "createsPlatformOperation",
        "externalSideEffect",
        "outboxEventClass",
        "requiredFinalizers"
      ],
      "properties": {
        "class": { "enum": ["operation_effect", "resource_change"] },
        "createsPlatformOperation": { "type": "boolean" },
        "externalSideEffect": { "enum": ["forbidden", "port_only"] },
        "outboxEventClass": { "enum": ["operation_effect", "resource_change"] },
        "requiredFinalizers": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          }
        }
      }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replayTtlSeconds", "pendingReplay", "terminalReplay", "conflict"],
      "properties": {
        "replayTtlSeconds": { "type": "integer", "minimum": 60, "maximum": 604800 },
        "pendingReplay": { "const": "in_progress_reference" },
        "terminalReplay": { "const": "redacted_terminal_envelope" },
        "conflict": { "const": "same_key_different_request_digest" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "resourceKind", "schemaId", "allowedFields"],
      "properties": {
        "kind": { "const": "resource_reference" },
        "resourceKind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "schemaId": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://schemas[.]cloud-agents[.]dev/platform/v1alpha1/schemas/[a-z0-9-]+[.]schema[.]json$"
        },
        "allowedFields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": ["resourceId", "resourceKind", "resourceVersion", "stableErrorCode"]
          }
        }
      }
    }
  },
  "x-cloud-agents-security": {
    "runtimeAuthority": "generated profileId plus profileDigest only",
    "callerProvidedOperationName": "forbidden",
    "secretBearingFields": "forbidden"
  }
}
