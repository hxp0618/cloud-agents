{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/platform/v1alpha1/schemas/remote-worker-sandbox-command.schema.json",
  "title": "RemoteWorkerSandboxCommand",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "commandId",
    "attempt",
    "action",
    "operationId",
    "workspaceId",
    "workspaceName",
    "targetId",
    "sandboxId",
    "sandboxGeneration",
    "imageUri",
    "cpuMillis",
    "memoryBytes",
    "specDigest",
    "networkPolicyId",
    "networkAllowedEgress",
    "deadline"
  ],
  "properties": {
    "commandId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 8 },
    "action": { "enum": ["sandbox.create", "sandbox.stop", "sandbox.rebuild"] },
    "operationId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "workspaceId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "workspaceName": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "targetId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "sandboxId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "sandboxGeneration": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "imageUri": { "type": "string", "maxLength": 1024, "pattern": "^[A-Za-z0-9._:/-]+@sha256:[0-9a-f]{64}$" },
    "cpuMillis": { "type": "integer", "minimum": 100, "maximum": 64000 },
    "memoryBytes": { "type": "integer", "minimum": 134217728, "maximum": 1099511627776 },
    "specDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "networkPolicyId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "networkAllowedEgress": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[^\\u0000-\\u0020\\u007F]+$" }
    },
    "physicalVolumeName": { "type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,62}$" },
    "runtimeId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
    "runtimeState": { "const": "Running" },
    "runtimeOperationId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "runtimeGeneration": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "runtimeSpecDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "deadline": { "type": "string", "format": "date-time", "maxLength": 64 }
  },
  "allOf": [
    {
      "if": { "properties": { "action": { "const": "sandbox.stop" } }, "required": ["action"] },
      "then": { "required": ["physicalVolumeName", "runtimeId", "runtimeState", "runtimeOperationId", "runtimeGeneration", "runtimeSpecDigest"] },
      "else": {
        "if": { "properties": { "action": { "const": "sandbox.rebuild" } }, "required": ["action"] },
        "then": {
          "required": ["physicalVolumeName"],
          "not": {
            "anyOf": [
              { "required": ["runtimeId"] },
              { "required": ["runtimeState"] },
              { "required": ["runtimeOperationId"] },
              { "required": ["runtimeGeneration"] },
              { "required": ["runtimeSpecDigest"] }
            ]
          }
        },
        "else": {
          "not": {
            "anyOf": [
              { "required": ["physicalVolumeName"] },
              { "required": ["runtimeId"] },
              { "required": ["runtimeState"] },
              { "required": ["runtimeOperationId"] },
              { "required": ["runtimeGeneration"] },
              { "required": ["runtimeSpecDigest"] }
            ]
          }
        }
      }
    }
  ],
  "x-cloud-agents-semantic-constraints": [
    "the mTLS route supplies tenant, project, enrollment, and incarnation authority",
    "commandId is unique to one durable Operation attempt and the node must not start it after deadline",
    "sandbox.stop is bound to the exact prior runtime and retained physical Workspace volume",
    "sandbox.rebuild creates a new runtime only on the exact retained physical Workspace volume",
    "the command contains no Control Plane target endpoint or credential reference"
  ]
}
