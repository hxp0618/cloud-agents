{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/platform/v1alpha1/schemas/network-policy.schema.json",
  "title": "NetworkPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "platform.cloud-agents.dev/v1alpha1" },
    "kind": { "const": "NetworkPolicy" },
    "metadata": { "$ref": "../../../common/v1alpha1/schemas/resource-metadata.schema.json" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectRef", "userSummary", "defaultEgress", "ingressEnabled", "previewEnabled"],
      "properties": {
        "projectRef": { "$ref": "../../../common/v1alpha1/schemas/project-ref.schema.json" },
        "userSummary": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" },
        "defaultEgress": { "enum": ["public", "restricted", "deny"] },
        "allowlistPolicyRef": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
        "ingressEnabled": { "type": "boolean" },
        "previewEnabled": { "type": "boolean" },
        "dnsPolicyRef": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
        "proxyPolicyRef": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" }
      }
    }
  },
  "x-cloud-agents-semantic-constraints": [
    "the Admin API exposes only opaque policy references and never resolves them to endpoint, credential, or secret bytes",
    "the User API receives userSummary through its published Environment Profile projection and never receives policy ids or references"
  ]
}
