{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/platform/v1alpha1/schemas/environment-profile-summary.schema.json",
  "title": "EnvironmentProfileSummary",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "projectRef", "profileId", "name", "version", "description", "status", "availability", "providerKinds", "cpuLimitMillis", "memoryLimitBytes"],
  "properties": {
    "apiVersion": { "const": "platform.cloud-agents.dev/v1alpha1" },
    "kind": { "const": "EnvironmentProfileSummary" },
    "projectRef": { "$ref": "../../../common/v1alpha1/schemas/project-ref.schema.json" },
    "profileId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "name": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "version": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "description": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" },
    "status": { "const": "published" },
    "availability": { "const": "available" },
    "providerKinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["codex", "claudeAgent"] }
    },
    "cpuLimitMillis": { "type": "integer", "minimum": 100, "maximum": 64000 },
    "memoryLimitBytes": { "type": "integer", "minimum": 134217728, "maximum": 1099511627776 }
  },
  "x-cloud-agents-semantic-constraints": [
    "the User API emits only published profiles with at least one ready project Target",
    "target references, credential references, release digests, endpoints, and policy references are absent"
  ]
}
