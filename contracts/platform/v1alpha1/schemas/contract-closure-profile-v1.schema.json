{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/platform/v1alpha1/schemas/contract-closure-profile-v1.schema.json",
  "title": "ContractClosureProfileV1",
  "description": "Generated digest-bound non-Gate G-CONTRACT closure profile registry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "registryId",
    "sourceDigest",
    "profile",
    "missing",
    "registryDigest"
  ],
  "properties": {
    "formatVersion": { "const": "cloud-agents-contract-closure-profile-registry/v1" },
    "registryId": { "const": "cloud-agents/platform/contract-closure-profile" },
    "sourceDigest": { "$ref": "#/$defs/digest" },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileDigest", "spec"],
      "properties": {
        "profileDigest": { "$ref": "#/$defs/digest" },
        "spec": { "$ref": "contract-closure-profile-source-v1.schema.json#/$defs/profile" }
      }
    },
    "missing": {
      "const": [
        "json-schema-2020-12-official-test-suite",
        "runtime-server-path-and-tenant-authority-enforcement",
        "remaining-generator-supply-chain-review"
      ]
    },
    "registryDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "x-cloud-agents-security": {
    "editable": false,
    "status": "BOOTSTRAP_VALIDATED",
    "notGateClosure": true,
    "gateStatus": "all_gates_open"
  }
}
