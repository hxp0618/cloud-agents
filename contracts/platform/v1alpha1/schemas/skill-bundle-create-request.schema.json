{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/platform/v1alpha1/schemas/skill-bundle-create-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundleId", "version", "digest", "sourceRef", "signatureRef", "signingKeyId", "compatibleProviders"],
  "properties": {
    "bundleId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "version": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sourceRef": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "signatureRef": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "signingKeyId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "compatibleProviders": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["codex", "claude-code", "pi", "deepseek-harness"] } }
  }
}
