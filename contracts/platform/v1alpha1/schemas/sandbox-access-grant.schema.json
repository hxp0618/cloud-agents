{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/platform/v1alpha1/schemas/sandbox-access-grant.schema.json",
  "title": "SandboxAccessGrant",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "projectRef", "grantId", "sandboxId", "generation", "accessKind", "accessToken", "sshUsername", "expiresAt"],
  "properties": {
    "apiVersion": { "const": "platform.cloud-agents.dev/v1alpha1" },
    "kind": { "const": "SandboxAccessGrant" },
    "projectRef": { "$ref": "../../../common/v1alpha1/schemas/project-ref.schema.json" },
    "grantId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "sandboxId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "accessKind": { "const": "sandbox" },
    "accessToken": { "type": "string", "pattern": "^cag1_[A-Za-z0-9_-]{43}$" },
    "sshUsername": { "type": "string", "maxLength": 386, "pattern": "^[A-Za-z0-9._~-]{1,128}:[A-Za-z0-9._~-]{1,128}:[A-Za-z0-9._~-]{1,128}$" },
    "expiresAt": { "type": "string", "format": "date-time", "maxLength": 64 }
  },
  "x-cloud-agents-semantic-constraints": [
    "accessToken is a short-lived bearer and SSH password credential returned only by the user grant API",
    "sshUsername fixes SSH access to the tenant, project and Grant; the Gateway independently revalidates the exact Sandbox generation",
    "no Target endpoint, runtime receipt or infrastructure credential is exposed"
  ]
}
