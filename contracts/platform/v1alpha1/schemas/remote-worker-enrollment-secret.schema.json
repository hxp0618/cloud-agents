{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/platform/v1alpha1/schemas/remote-worker-enrollment-secret.schema.json",
  "title": "RemoteWorkerEnrollmentSecret",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "projectRef", "enrollmentId", "enrollmentSecret", "expiresAt"],
  "properties": {
    "apiVersion": { "const": "platform.cloud-agents.dev/v1alpha1" },
    "kind": { "const": "RemoteWorkerEnrollmentSecret" },
    "projectRef": { "$ref": "../../../common/v1alpha1/schemas/project-ref.schema.json" },
    "enrollmentId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "enrollmentSecret": { "type": "string", "pattern": "^carw1_[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$" },
    "expiresAt": { "type": "string", "format": "date-time" }
  },
  "x-cloud-agents-semantic-constraints": [
    "this response is emitted exactly once through the no-store bootstrap route and is never persisted as plaintext",
    "Admin Web and durable audit/resource projections never receive enrollmentSecret"
  ]
}
