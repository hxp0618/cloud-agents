{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/platform/v1alpha1/schemas/worker-page.schema.json",
  "title": "WorkerPage",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "workers"],
  "properties": {
    "apiVersion": { "const": "platform.cloud-agents.dev/v1alpha1" },
    "kind": { "const": "WorkerPage" },
    "workers": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "worker.schema.json" }
    },
    "nextPageToken": {
      "$ref": "../../../common/v1alpha1/schemas/page-token.schema.json"
    }
  }
}
