{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/platform/v1alpha1/schemas/runtime-profile.schema.json",
  "title": "RuntimeProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "platform.cloud-agents.dev/v1alpha1" },
    "kind": { "const": "RuntimeProfile" },
    "metadata": { "$ref": "../../../common/v1alpha1/schemas/resource-metadata.schema.json" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectRef", "profileId", "version", "description", "status", "targetId", "imageUri", "releaseDigest", "cpuMillis", "memoryBytes"],
      "properties": {
        "projectRef": { "$ref": "../../../common/v1alpha1/schemas/project-ref.schema.json" },
        "profileId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
        "version": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" },
        "status": { "enum": ["draft", "published", "disabled"] },
        "targetId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
        "imageUri": { "type": "string", "maxLength": 1024, "pattern": "^[A-Za-z0-9._:/-]+@sha256:[0-9a-f]{64}$" },
        "releaseDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "cpuMillis": { "type": "integer", "minimum": 100, "maximum": 64000 },
        "memoryBytes": { "type": "integer", "minimum": 134217728, "maximum": 1099511627776 },
        "publishedAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "disabledAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      }
    }
  },
  "x-cloud-agents-semantic-constraints": [
    "draft has no lifecycle timestamp, published has only publishedAt, and disabled has both timestamps",
    "target, image and release are Admin-only and immutable for a version"
  ]
}
