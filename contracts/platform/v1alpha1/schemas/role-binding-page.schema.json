  "$id": "https://schemas.cloud-agents.dev/platform/v1alpha1/schemas/role-binding-page.schema.json",
  "title": "RoleBindingPage",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "roleBindings"],
