{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/platform/v1alpha1/schemas/workspace-snapshot.schema.json",
  "title": "WorkspaceSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "platform.cloud-agents.dev/v1alpha1" },
    "kind": { "const": "WorkspaceSnapshot" },
    "metadata": { "$ref": "../../../common/v1alpha1/schemas/resource-metadata.schema.json" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectRef",
        "sourceWorkspaceId",
        "sourceWorkspaceResourceVersion",
        "backend",
        "consistencyMode",
        "status",
        "operationId"
      ],
      "properties": {
        "projectRef": { "$ref": "../../../common/v1alpha1/schemas/project-ref.schema.json" },
        "sourceWorkspaceId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
        "sourceWorkspaceResourceVersion": { "type": "string", "pattern": "^[1-9][0-9]{0,18}$" },
        "backend": { "const": "docker-volume-v1" },
        "consistencyMode": { "const": "offline" },
        "status": { "enum": ["pending", "available", "unknown", "failed"] },
        "operationId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
        "sizeBytes": { "type": "integer", "minimum": 0, "maximum": 67108864 },
        "stableErrorCode": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
        "observedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      }
    }
  },
  "x-cloud-agents-semantic-constraints": [
    "Admin projection is metadata-only and never exposes paths, file bytes, content digests, endpoints, credentials or Secret bytes",
    "available requires sizeBytes and observedAt; failed requires stableErrorCode and observedAt",
    "docker-volume-v1 uses an offline copy after the source Workspace writer is durably fenced"
  ]
}
