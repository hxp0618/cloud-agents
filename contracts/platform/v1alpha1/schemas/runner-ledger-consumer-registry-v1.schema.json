{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/platform/v1alpha1/schemas/runner-ledger-consumer-registry-v1.schema.json",
  "title": "RunnerLedgerConsumerRegistryV1",
  "description": "Generated, preflight-v1-bound complete-ledger no-op consumer registry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "registryId",
    "sourceDigest",
    "stateMachineDigest",
    "policyDigest",
    "preflightBinding",
    "profile",
    "stateMachine",
    "selector",
    "implementationBoundary",
    "registryDigest"
  ],
  "properties": {
    "formatVersion": { "const": "cloud-agents-runner-ledger-consumer-registry/v1" },
    "registryId": { "const": "cloud-agents/platform/runner-ledger-consumer" },
    "sourceDigest": { "$ref": "#/$defs/digest" },
    "stateMachineDigest": { "$ref": "#/$defs/digest" },
    "policyDigest": { "$ref": "#/$defs/digest" },
    "preflightBinding": { "$ref": "#/$defs/preflightBinding" },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileDigest", "spec"],
      "properties": {
        "profileDigest": { "$ref": "#/$defs/digest" },
        "spec": {
          "$ref": "runner-ledger-consumer-registry-source-v1.schema.json#/$defs/profile"
        }
      }
    },
    "stateMachine": {
      "$ref": "runner-ledger-consumer-registry-source-v1.schema.json#/$defs/stateMachine"
    },
    "selector": {
      "$ref": "runner-ledger-consumer-registry-source-v1.schema.json#/$defs/selector"
    },
    "implementationBoundary": {
      "$ref": "runner-ledger-consumer-registry-source-v1.schema.json#/$defs/implementationBoundary"
    },
    "registryDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "preflightBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registryId",
        "registryDigest",
        "stateMachineDigest",
        "policyDigest",
        "profileId",
        "profileDigest"
      ],
      "properties": {
        "registryId": { "const": "cloud-agents/platform/runner-ledger-preflight" },
        "registryDigest": { "$ref": "#/$defs/digest" },
        "stateMachineDigest": { "$ref": "#/$defs/digest" },
        "policyDigest": { "$ref": "#/$defs/digest" },
        "profileId": { "const": "runner-ledger-preflight/v1" },
        "profileDigest": { "$ref": "#/$defs/digest" }
      }
    }
  },
  "x-cloud-agents-security": {
    "editable": false,
    "consumerLookup": "exact profileId plus profileDigest",
    "preflightLookup": "exact immutable generated v1 identity",
    "writerAuthority": "none"
  }
}
