{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/platform/v1alpha1/schemas/membership.schema.json",
  "title": "Membership",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "const": "platform.cloud-agents.dev/v1alpha1"
    },
    "kind": {
      "const": "Membership"
    },
    "metadata": {
      "$ref": "../../../common/v1alpha1/schemas/resource-metadata.schema.json"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantRef", "subject", "scope", "state"],
      "properties": {
        "tenantRef": {
          "$ref": "../../../common/v1alpha1/schemas/tenant-ref.schema.json"
        },
        "subject": {
          "$ref": "../../../common/v1alpha1/schemas/subject-ref.schema.json"
        },
        "scope": {
          "$ref": "../../../common/v1alpha1/schemas/authorization-scope.schema.json"
        },
        "state": {
          "type": "string",
          "enum": ["active", "suspended", "revoked"]
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      }
    }
  },
  "x-cloud-agents-semantic-constraints": [
    "metadata.tenantRef == spec.tenantRef",
    "spec.scope.ref belongs to spec.tenantRef when scope level is not platform",
    "platform scope requires platform authority"
  ]
}
