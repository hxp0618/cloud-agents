{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/platform/v1alpha1/schemas/storage-policy-page.schema.json",
  "title": "StoragePolicyPage",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "storagePolicies"],
