{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/platform/v1alpha1/schemas/remote-worker-sandbox-exec-command-receipt.schema.json",
  "title": "RemoteWorkerSandboxExecCommandReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["commandId", "sandboxId", "sandboxGeneration", "result", "exitCode", "stdout", "stderr", "executionTimeMillis"],
  "properties": {
    "commandId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "sandboxId": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
    "sandboxGeneration": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "result": { "enum": ["succeeded", "failed"] },
    "exitCode": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
    "stdout": { "type": "string", "maxLength": 1048576 },
    "stderr": { "type": "string", "maxLength": 1048576 },
    "executionTimeMillis": { "type": "integer", "minimum": 0, "maximum": 65000 },
    "stableErrorCode": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" }
  },
  "allOf": [
    {
      "if": { "properties": { "result": { "const": "succeeded" } }, "required": ["result"] },
      "then": {
        "required": ["exitCode", "stdout", "stderr", "executionTimeMillis"],
        "not": { "required": ["stableErrorCode"] }
      },
      "else": {
        "required": ["stableErrorCode"],
        "properties": {
          "exitCode": { "const": 0 },
          "stdout": { "const": "" },
          "stderr": { "const": "" },
          "executionTimeMillis": { "const": 0 }
        }
      }
    }
  ],
  "x-cloud-agents-semantic-constraints": [
    "stdout and stderr contain at most 1048576 UTF-8 bytes combined",
    "a non-zero command exit code is still a succeeded transport receipt",
    "runtime identifiers, endpoints and credentials are absent"
  ]
}
