{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloud-agents.dev/platform/v1alpha1/schemas/worker-release.schema.json",
  "title": "WorkerRelease",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "platform.cloud-agents.dev/v1alpha1" },
    "kind": { "const": "WorkerRelease" },
    "metadata": { "$ref": "../../../common/v1alpha1/schemas/resource-metadata.schema.json" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectRef", "imageRepository", "releaseDigest", "platformVersion", "runtimeVersion", "codexVersion", "claudeCodeVersion", "architectures", "status", "verificationState", "verificationEvidenceDigest", "approvedAt"],
      "properties": {
        "projectRef": { "$ref": "../../../common/v1alpha1/schemas/project-ref.schema.json" },
        "imageRepository": { "type": "string", "minLength": 3, "maxLength": 512, "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*(?::[0-9]{1,5})?(?:/[a-z0-9]+(?:[._-][a-z0-9]+)*)+$" },
        "releaseDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "platformVersion": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
        "runtimeVersion": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
        "codexVersion": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
        "claudeCodeVersion": { "$ref": "../../../common/v1alpha1/schemas/identifier.schema.json" },
        "architectures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["linux/amd64", "linux/arm64"] }
        },
        "status": { "const": "approved" },
        "verificationState": { "const": "attested" },
        "verificationEvidenceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "approvedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      }
    }
  },
  "x-cloud-agents-semantic-constraints": [
    "one immutable approved Worker release is identified by metadata.uid and releaseDigest",
    "registration records an operator-attested evidence digest; it does not expose evidence or registry credentials",
    "approved Worker releases are Admin API resources and are never returned by the User API"
  ]
}
