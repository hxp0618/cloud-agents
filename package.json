{
  "name": "cloud-agents-portable-runtime",
  "version": "0.0.0",
  "private": true,
  "description": "Portable Cloud Agent protocol, provider ABI, runtime, providers, testkit, and pinned distribution",
  "homepage": "https://github.com/hxp0618/cloud-agents#readme",
  "bugs": {
    "url": "https://github.com/hxp0618/cloud-agents/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hxp0618/cloud-agents.git"
  },
  "workspaces": [
    "packages/*",
    "sdk/typescript",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter '@cloud-agents/*' build",
    "check": "bun run fmt:check && sh scripts/test-cloud-agents-helm.sh && bun run lint && bun run platform:go:check && bun run platform:contracts:check && bun run platform:migrations:check && sh scripts/test-platform-go-products.sh && bun run typecheck && bun run --filter '@cloud-agents/*' test && bunx vitest run scripts && bun run build",
    "dev": "bash scripts/cloud-agents-dev.sh",
    "fmt": "bun scripts/run-oxfmt.ts --write",
    "fmt:check": "bun scripts/run-oxfmt.ts --check",
    "lint": "oxlint . --deny-warnings --ignore-pattern scripts/lib/platform-contract-lock.ts",
    "typecheck": "bun run --filter '@cloud-agents/*' typecheck",
    "test": "bun run --filter '@cloud-agents/*' test && vitest run scripts",
    "release:smoke": "node scripts/cloud-agent-release-smoke.ts",
    "runtime:capabilities:generate": "bun scripts/generate-runtime-capability-materialization.ts",
    "platform:release": "bun scripts/cloud-agents-platform-release.ts",
    "release:sbom": "node scripts/generate-sbom.ts",
    "secret:scan": "bun scripts/secret-scan.ts",
    "platform:contracts:check": "bun scripts/check-platform-contracts.ts --check",
    "platform:contracts:ajv-official-suite:audit": "bun scripts/check-platform-ajv-official-suite.ts --check",
    "platform:contracts:ajv-official-suite:require-conformance": "bun scripts/check-platform-ajv-official-suite.ts --require-conformance",
    "platform:contracts:standards:check": "bun scripts/check-platform-contract-standards.ts",
    "platform:contracts:generate": "bun scripts/check-platform-contracts.ts --write",
    "platform:sdk:consumers": "bun scripts/test-platform-sdk-consumers.ts",
    "platform:sdk:check": "bun scripts/generate-platform-identity-sdks.ts --check && bun scripts/generate-platform-json-sdks.ts --check && bun scripts/generate-platform-proto-sdks.ts --check",
    "platform:sdk:generate": "bun scripts/generate-platform-identity-sdks.ts --write && bun scripts/generate-platform-json-sdks.ts --write && bun scripts/generate-platform-proto-sdks.ts --write",
    "platform:migrations:check": "bun scripts/check-platform-migration-bundle.ts && bun scripts/generate-platform-migration-bundle.ts --check && bun scripts/generate-foundation-migration-package.ts --check",
    "platform:go:check": "bun scripts/check-platform-go-modules.ts",
    "platform:go:test": "GOTOOLCHAIN=local GOFLAGS=-mod=readonly go -C services/control-plane test ./... && GOTOOLCHAIN=local GOFLAGS=-mod=readonly go -C services/control-plane test -race ./... && GOTOOLCHAIN=local GOFLAGS=-mod=readonly go -C services/control-plane vet ./... && GOTOOLCHAIN=local GOFLAGS=-mod=readonly go -C services/control-plane mod verify && GOTOOLCHAIN=local GOFLAGS=-mod=readonly go -C services/worker mod verify && GOTOOLCHAIN=local GOFLAGS=-mod=readonly go -C sdk/go mod verify"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "2.14.0",
    "@bufbuild/protoc-gen-es": "2.14.0",
    "@types/node": "24.10.13",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "pnpm": "11.10.0",
    "tsdown": "0.20.3",
    "typescript": "5.7.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "24.18.1"
  },
  "packageManager": "bun@1.3.14"
}
