	response, err := client.roundTrip(ctx, Request{Method: "GET", Path: path, Headers: map[string]string{HeaderRequestID: requestID}}); if err != nil { return zero, err }
	if response.Status != 200 { return zero, client.problemError(operation, response) }
	value, err := decode(response.Body); if err != nil { return zero, &ClientError{Operation: operation, Status: response.Status, Cause: err} }
	if err := requireResourceVersion(response, resourceVersion(value.Value)); err != nil { return zero, err }
