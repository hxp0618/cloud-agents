	if metadataUID(value.Value) != resourceID { return zero, common.ContractError("PATH_BODY_AUTHORITY_MISMATCH", "/metadata/uid") }
	return value, nil
}
func doMutation(ctx context.Context, client *Client, operation, path, tenantID, resourceID, requestID string, body []byte, status int) (common.ResponseEnvelope[platform.RBACMutationResult], error) {
